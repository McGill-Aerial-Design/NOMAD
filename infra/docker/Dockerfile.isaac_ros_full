# ==============================================================
# NOMAD Isaac ROS Container Dockerfile
#
# Built on the official Isaac ROS dev image (produced by
# isaac_ros_common/scripts/build_image_layers.sh).
#
# What this layer adds on top of the official base:
#   - ZED SDK 4.1 (matching ZED ROS2 wrapper version)
#   - Runtime apt deps that get wiped on container restart
#   - GStreamer for video bridge (simple_video_bridge.py)
#   - Python helpers (transforms3d, pymavlink)
#
# IMPORTANT -- The official Isaac ROS dev image must be built
# first on the Jetson.  See docs/ISAAC_ROS_NVBLOX_SETUP.md.
#
# Build (on Jetson):
#   docker build -f infra/docker/Dockerfile.isaac_ros_full \
#       --build-arg BASE_IMAGE=isaac_ros_dev-aarch64 \
#       -t nomad-isaac-ros:latest .
#
# Or via docker compose:
#   docker compose build isaac-ros
# ==============================================================

ARG BASE_IMAGE=isaac_ros_dev-aarch64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="NOMAD Team"
LABEL description="NOMAD Isaac ROS + ZED + nvblox for Jetson Orin Nano"

# ==============================================================
# System Dependencies
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    libusb-1.0-0-dev \
    python3-numpy \
    # GStreamer for video bridge
    python3-gi \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# ROS2 Dependencies (needed by nvblox + ZED + nav2 after restart)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-zed-msgs \
    ros-humble-robot-localization \
    ros-humble-point-cloud-transport \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-nav2-msgs \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# ZED SDK 4.2 for L4T 36.4 (JetPack 6.2)
# ==============================================================
ENV ZED_SDK_URL="https://download.stereolabs.com/zedsdk/4.2/l4t36.4/jetsons"

RUN curl -L -o /tmp/zed_sdk.run ${ZED_SDK_URL} && \
    chmod +x /tmp/zed_sdk.run && \
    /tmp/zed_sdk.run -- silent skip_od_module && \
    rm /tmp/zed_sdk.run && \
    ldconfig

RUN test -f /usr/local/zed/lib/libsl_zed.so && \
    echo "ZED SDK installed successfully"

ENV LD_LIBRARY_PATH="/usr/local/zed/lib:${LD_LIBRARY_PATH}"

# ==============================================================
# Python Dependencies
# ==============================================================
RUN pip3 install --no-cache-dir \
    transforms3d \
    pymavlink \
    'numpy<2'

# ==============================================================
# Build isaac_ros_nvblox_utils (persisted in /opt, not mounted)
# ==============================================================
# This builds the critical nvblox utilities package to a container-layer path
# that persists independently of the host workspace mount. This ensures the
# package is always available even if the host workspace is missing it.
WORKDIR /tmp/isaac_nvblox_build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    git clone --branch release-3.2 --depth 1 \
        https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git /tmp/isaac_nvblox_src && \
    rm -rf /var/lib/apt/lists/*

# Build only isaac_ros_nvblox_utils to /opt/isaac_ros_installed
RUN bash -c "
    set -e; \
    mkdir -p /opt/isaac_ros_installed; \
    source /opt/ros/humble/setup.bash 2>/dev/null || source /opt/ros/humble/install/setup.bash 2>/dev/null; \
    cd /tmp; \
    mkdir -p colcon_ws/src; \
    cp -r /tmp/isaac_nvblox_src/isaac_ros_nvblox_utils colcon_ws/src/; \
    cd colcon_ws; \
    colcon build --packages-select isaac_ros_nvblox_utils \
        --install-base /opt/isaac_ros_installed \
        --symlink-install --cmake-args -Wno-dev 2>&1 | tail -20; \
    rm -rf /tmp/colcon_ws /tmp/isaac_nvblox_src; \
"

# Update ROS_PACKAGE_PATH to include the pre-built nvblox_utils package
# This ensures it's discoverable before the workspace mount
ENV ROS_PACKAGE_PATH="/opt/isaac_ros_installed/share:${ROS_PACKAGE_PATH}"
ENV CMAKE_PREFIX_PATH="/opt/isaac_ros_installed:${CMAKE_PREFIX_PATH}"

# ==============================================================
# Workspace
# ==============================================================
WORKDIR /workspaces/isaac_ros-dev

# ==============================================================
# Environment
# ==============================================================
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:/usr/local/zed/lib:${LD_LIBRARY_PATH}"

# ==============================================================
# Entrypoint
# ==============================================================
COPY infra/docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
