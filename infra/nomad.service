# NOMAD Edge Core Systemd Service
# Location: /etc/systemd/system/nomad.service
# 
# Installation:
#   sudo cp nomad.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable nomad
#   sudo systemctl start nomad
#
# Management:
#   sudo systemctl status nomad
#   sudo journalctl -u nomad -f
#   sudo systemctl restart nomad

[Unit]
Description=NOMAD Edge Core Orchestrator
Documentation=https://github.com/NOMAD/edge_core
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=mad
Group=mad
# Use %h systemd specifier for home directory (/home/mad when User=mad)
WorkingDirectory=%h/NOMAD

# Environment variables
Environment="NOMAD_SIM_MODE=false"
Environment="PYTHONUNBUFFERED=1"
# Use %h systemd specifier for home directory to support user-agnostic deployment
Environment="PYTHONPATH=%h/NOMAD"
# User-local libs (libturbojpeg for ZED SDK) + CUDA
Environment="LD_LIBRARY_PATH=%h/.local/lib:/usr/local/cuda/lib64"

# Run via the edge_core CLI entry point (main.py:main()) so all services —
# MAVLink, health monitor, video stream manager, servo controller, etc. —
# are properly initialized before uvicorn starts.
# Using the venv Python ensures all pip dependencies (fastapi, uvicorn,
# pydantic, pymavlink, ...) are available regardless of system Python state.
ExecStart=%h/NOMAD/venv/bin/python3 -m edge_core.main --host 0.0.0.0 --port 8000 --log-level info

# Restart policy
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad

# Security hardening (adjust as needed)
NoNewPrivileges=true
PrivateTmp=true

# Watchdog support (if systemd watchdog is used)
# WatchdogSec=60

[Install]
WantedBy=multi-user.target
