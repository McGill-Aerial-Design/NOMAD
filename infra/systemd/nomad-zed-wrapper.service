[Unit]
Description=NOMAD ZED ROS2 Wrapper (in container)
After=nomad-isaac-ros-container.service
Requires=nomad-isaac-ros-container.service
PartOf=nomad.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__NOMAD_USER__
Group=__NOMAD_USER__
WorkingDirectory=__NOMAD_ROOT__
EnvironmentFile=__NOMAD_ROOT__/config/nomad.env

ExecStart=/bin/bash __NOMAD_ROOT__/scripts/services/zed_wrapper.sh start
ExecStop=/bin/bash __NOMAD_ROOT__/scripts/services/zed_wrapper.sh stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-zed-wrapper

[Install]
WantedBy=nomad.target
