[Unit]
Description=NOMAD ROS<->HTTP Bridge (in container)
After=nomad-isaac-ros-container.service nomad-edge-core.service
Requires=nomad-isaac-ros-container.service
Wants=nomad-edge-core.service
PartOf=nomad.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__NOMAD_USER__
Group=__NOMAD_USER__
WorkingDirectory=__NOMAD_ROOT__
EnvironmentFile=__NOMAD_ROOT__/config/nomad.env

ExecStart=/bin/bash __NOMAD_ROOT__/scripts/services/ros_http_bridge.sh start
ExecStop=/bin/bash __NOMAD_ROOT__/scripts/services/ros_http_bridge.sh stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-ros-http-bridge

[Install]
WantedBy=nomad.target
