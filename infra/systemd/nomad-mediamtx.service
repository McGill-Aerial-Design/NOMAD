[Unit]
Description=NOMAD MediaMTX RTSP Server
After=network-online.target
Wants=network-online.target
PartOf=nomad.target

[Service]
# oneshot+RemainAfterExit because mediamtx.sh's `start` action backgrounds
# mediamtx with nohup and exits 0. Type=forking would need a PIDFile.
Type=oneshot
RemainAfterExit=yes
User=mad
Group=mad
WorkingDirectory=/home/mad/NOMAD
EnvironmentFile=/home/mad/NOMAD/config/nomad.env

ExecStart=/bin/bash /home/mad/NOMAD/scripts/services/mediamtx.sh start
ExecStop=/bin/bash /home/mad/NOMAD/scripts/services/mediamtx.sh stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-mediamtx

[Install]
WantedBy=nomad.target
