[Unit]
Description=NOMAD Isaac ROS Container (sleep infinity host)
After=docker.service
Requires=docker.service
PartOf=nomad.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=mad
Group=mad
WorkingDirectory=/home/mad/NOMAD
EnvironmentFile=/home/mad/NOMAD/config/nomad.env

ExecStart=/home/mad/NOMAD/scripts/services/isaac_ros_container.sh start
ExecStop=/home/mad/NOMAD/scripts/services/isaac_ros_container.sh stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-isaac-ros-container

[Install]
WantedBy=nomad.target
