[Unit]
Description=NOMAD MAVLink Router
After=network-online.target
Wants=network-online.target
PartOf=nomad.target

[Service]
# Keep the wrapper in the foreground so systemd sees router exits after Cube
# USB resets and the wrapper can rediscover the serial device.
Type=simple
User=mad
Group=mad
WorkingDirectory=/home/mad/NOMAD
EnvironmentFile=/home/mad/NOMAD/config/nomad.env

ExecStart=/bin/bash /home/mad/NOMAD/scripts/services/mavlink_router.sh run
ExecStop=/bin/bash /home/mad/NOMAD/scripts/services/mavlink_router.sh stop
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-mavlink-router

[Install]
WantedBy=nomad.target
