[Unit]
Description=NOMAD aircraft serial MAVLink fan-out
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nomad
SupplementaryGroups=dialout
ExecStart=/usr/bin/mavlink-routerd -c /etc/nomad/router.conf
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
