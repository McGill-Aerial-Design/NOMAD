[Unit]
Description=NOMAD MAVLink Router
After=network-online.target
Wants=network-online.target
PartOf=nomad.target

[Service]
# oneshot+RemainAfterExit because mavlink_router.sh's `start` action backgrounds
# mavlink-routerd with nohup and exits 0. Type=forking would need a PIDFile.
Type=oneshot
RemainAfterExit=yes
User=mad
Group=mad
WorkingDirectory=/home/mad/NOMAD
EnvironmentFile=/home/mad/NOMAD/config/nomad.env

ExecStart=/bin/bash /home/mad/NOMAD/scripts/services/mavlink_router.sh start
ExecStop=/bin/bash /home/mad/NOMAD/scripts/services/mavlink_router.sh stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-mavlink-router

[Install]
WantedBy=nomad.target
