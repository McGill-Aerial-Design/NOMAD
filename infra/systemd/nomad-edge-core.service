[Unit]
Description=NOMAD Edge Core API
Documentation=https://github.com/NOMAD/edge_core
After=network-online.target tailscaled.service
Wants=network-online.target
PartOf=nomad.target

[Service]
Type=simple
User=__NOMAD_USER__
Group=__NOMAD_USER__
WorkingDirectory=__NOMAD_ROOT__
EnvironmentFile=__NOMAD_ROOT__/config/nomad.env

ExecStart=__NOMAD_ROOT__/venv/bin/python3 -m edge_core.main \
    --host ${NOMAD_API_HOST} --port ${NOMAD_API_PORT} --log-level info

Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

LimitNOFILE=65536
LimitNPROC=4096
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RuntimeDirectory=nomad
RuntimeDirectoryMode=0755
ReadWritePaths=__NOMAD_ROOT__ __NOMAD_HOME__/nomad_logs __NOMAD_HOME__/.nomad /run/nomad

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nomad-edge-core

[Install]
WantedBy=nomad.target
