# =============================================================================
# NOMAD - Single Source of Truth Configuration
# =============================================================================
# This file is the ONLY runtime configuration file for NOMAD services.
# It is sourced by:
#   - scripts/nomad CLI and every per-service script under scripts/services/
#   - Edge Core (via EnvironmentFile= in infra/systemd/nomad-edge-core.service)
#
# Copy to this path on the Jetson and edit values for the deployment:
#   /home/mad/NOMAD/config/nomad.env
#
# Anything that used to live in:
#   - config/env/jetson.env
#   - inline `export` statements in scripts/run/*.sh
#   - the old `start_isaac_ros_auto.sh` defaults
# belongs HERE now. No other file should define runtime env vars.
# =============================================================================

# ---------------------------------------------------------------------------
# Service Autostart Set
# ---------------------------------------------------------------------------
# Which services are started by `nomad start all` and enabled at boot.
# Set to "false" to opt a service out of the autostart group.
# Individual services can still be started manually via `nomad start <svc>`.

NOMAD_AUTOSTART_EDGE_CORE=true
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
NOMAD_AUTOSTART_MEDIAMTX=true
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=true
NOMAD_AUTOSTART_ZED_WRAPPER=true
NOMAD_AUTOSTART_ROS_HTTP_BRIDGE=true
NOMAD_AUTOSTART_VIDEO_BRIDGE=true
NOMAD_AUTOSTART_NVBLOX=false

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
NOMAD_REPO_ROOT=/home/mad/NOMAD
NOMAD_LOG_DIR=/home/mad/nomad_logs
NOMAD_RUN_DIR=/run/nomad
NOMAD_DATA_DIR=/home/mad/NOMAD/data
NOMAD_LANDMARKS_PATH=/home/mad/NOMAD/config/landmarks.json
NOMAD_MISSION_LOG_DIR=/home/mad/NOMAD/data/mission_logs
NOMAD_VENV=/home/mad/NOMAD/venv

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NOMAD_API_HOST=0.0.0.0
NOMAD_API_PORT=8000
NOMAD_API_URL=http://localhost:8000

# Tailscale / GCS (leave GCS_IP blank to discover via `tailscale status`)
GCS_IP=
GCS_PORT_LTE=14560
GCS_PORT_LOCAL=14550

# Auth tokens (must match Edge Core configuration)
NOMAD_API_KEY=
NOMAD_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# MAVLink Router
# ---------------------------------------------------------------------------
MAVLINK_UART_DEV=/dev/ttyACM0
MAVLINK_UART_BAUD=921600

# ---------------------------------------------------------------------------
# MediaMTX (RTSP server)
# ---------------------------------------------------------------------------
RTSP_PORT=8554
MEDIAMTX_CONFIG=/home/mad/NOMAD/infra/mediamtx.yml
MEDIAMTX_BIN=/home/mad/bin/mediamtx

# ---------------------------------------------------------------------------
# Isaac ROS Container
# ---------------------------------------------------------------------------
ISAAC_CONTAINER_NAME=nomad_isaac_ros
ISAAC_IMAGE_NAME=nomad-isaac-ros:latest
ISAAC_IMAGE_FALLBACK=isaac_ros_dev-aarch64
ISAAC_WORKSPACE=/home/mad/workspaces/isaac_ros-dev
ISAAC_ROS_DOMAIN_ID=0

# ZED SDK pinned versions (provisioning installs these; runtime checks them)
ZED_WRAPPER_BRANCH=v5.2.0
ZED_SDK_VERSION=5.2.3
ZED_SDK_L4T_TARGET=l4t36.4

# ---------------------------------------------------------------------------
# ZED Wrapper (runtime)
# ---------------------------------------------------------------------------
ZED_CAMERA_MODEL=zed2i
ZED_CAMERA_NAME=zed
ZED_PUB_RESOLUTION=NATIVE
# 720p — fits 8GB Orin Nano alongside nvblox. Switch to HD1080 only if ZED
# is the only GPU consumer.
ZED_GRAB_RESOLUTION=HD720
ZED_PUB_DOWNSCALE_FACTOR=2.0
ZED_PUBLISH_RAW=true
ZED_PUBLISH_LEFT_RIGHT=true
ZED_PUBLISH_MAG=true
ZED_DEPTH_CONFIDENCE=50
ZED_DEPTH_TEXTURE_CONF=70
ZED_READY_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# ROS-HTTP Bridge
# ---------------------------------------------------------------------------
ROS_HTTP_BRIDGE_RATE=30
ROS_HTTP_BRIDGE_VIO_TOPIC=/zed/zed_node/odom
ROS_HTTP_BRIDGE_MAG_TOPIC=/zed/zed_node/imu/mag
ROS_HTTP_BRIDGE_TRANSPORT=zmq

# ---------------------------------------------------------------------------
# Video Bridge
# ---------------------------------------------------------------------------
VIDEO_BRIDGE_STREAM_PATH=primary
VIDEO_BRIDGE_WIDTH=1280
VIDEO_BRIDGE_HEIGHT=720
VIDEO_BRIDGE_FPS=15
VIDEO_BRIDGE_BITRATE=2500
# Lifecycle owner: nomad-video-bridge.service (no in-process auto-start).

# ---------------------------------------------------------------------------
# nvblox (opt-in)
# ---------------------------------------------------------------------------
NVBLOX_CONFIG=/home/mad/NOMAD/config/nvblox_performance.yaml
NVBLOX_LAUNCH=/home/mad/NOMAD/config/launch/nomad_zed_nvblox.launch.py
NVBLOX_ENABLE_OD=false
NVBLOX_ENABLE_NAV2=false

# ---------------------------------------------------------------------------
# Misc / feature flags
# ---------------------------------------------------------------------------
NOMAD_DEBUG=false
NOMAD_ENABLE_VISION=true
NOMAD_WATCHDOG_TIMEOUT=5.0
PYTHONUNBUFFERED=1
