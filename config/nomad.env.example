# =============================================================================
# NOMAD - Single Source of Truth Configuration (EXAMPLE)
# =============================================================================
# Copy this file to `config/nomad.env` and edit the values for your deployment:
#
#   cp config/nomad.env.example config/nomad.env
#
# `config/nomad.env` is gitignored — it holds your real secrets and host paths.
# This file is sourced by:
#   - the `scripts/nomad` CLI and every per-service script under scripts/services/
#   - Edge Core (via EnvironmentFile= in the systemd units under infra/systemd/)
#
# NOTE: systemd EnvironmentFile= does NOT expand ${VAR} references between lines,
# so every path below must be a literal absolute path (no variable interpolation).
# Replace `USER` with the login user that owns the checkout on the device.
# =============================================================================

# ---------------------------------------------------------------------------
# Service Autostart Set
# ---------------------------------------------------------------------------
# Which services are started by `nomad start all` and enabled at boot.
# Set to "false" to opt a service out of the autostart group.
# Individual services can still be started manually via `nomad start <svc>`.

NOMAD_AUTOSTART_EDGE_CORE=true
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
NOMAD_AUTOSTART_MEDIAMTX=true
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=true
NOMAD_AUTOSTART_ZED_WRAPPER=true
NOMAD_AUTOSTART_ROS_HTTP_BRIDGE=true
NOMAD_AUTOSTART_VIDEO_BRIDGE=true
# nvblox is manual-only. Mission Planner Service Control may start/stop it,
# but install.sh and `nomad start all` intentionally ignore this flag.
NOMAD_AUTOSTART_NVBLOX=false

# ---------------------------------------------------------------------------
# Paths  (replace USER with the device's login user)
# ---------------------------------------------------------------------------
NOMAD_REPO_ROOT=/home/USER/NOMAD
NOMAD_LOG_DIR=/home/USER/nomad_logs
NOMAD_RUN_DIR=/run/nomad
NOMAD_DATA_DIR=/home/USER/NOMAD/data
NOMAD_MISSION_LOG_DIR=/home/USER/NOMAD/data/mission_logs
NOMAD_VENV=/home/USER/NOMAD/venv

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
NOMAD_API_HOST=0.0.0.0
NOMAD_API_PORT=8000
NOMAD_API_URL=http://localhost:8000
# Docker bridge / host IP (default 172.17.0.1 for Docker bridge).
# Override when using host networking or non-default bridge.
NOMAD_DOCKER_HOST_IP=172.17.0.1
# Edge Core hostname for Tailscale registration.
NOMAD_TAILSCALE_HOSTNAME=nomad-jetson

# Tailscale / GCS (leave GCS_IP blank to discover via `tailscale status`)
GCS_IP=
# Optional extra ground-station Tailscale IPs that should also receive
# MAVLink LTE telemetry. Separate multiple IPs with spaces or commas.
# Example: GCS_EXTRA_IPS="100.64.0.10 100.64.0.11"
GCS_EXTRA_IPS=
GCS_PORT_LTE=14560
GCS_PORT_LOCAL=14550

# Auth tokens (must match the Mission Planner plugin configuration)
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in the Mission Planner plugin (NOMADConfig.JetsonApiKey),
# then keep NOMAD_ALLOW_INSECURE_REMOTE=false.
NOMAD_API_KEY=
NOMAD_INTERNAL_TOKEN=
# Leave false in deployed environments. With no NOMAD_API_KEY, Edge Core only
# accepts loopback clients unless this is explicitly set true for local testing.
NOMAD_ALLOW_INSECURE_REMOTE=false
# Arbitrary /api/terminal/exec is disabled by default even when API auth is on.
NOMAD_ENABLE_TERMINAL_EXEC=false
# Required before using the start_novnc terminal command.
NOVNC_VNC_PASSWORD=

# ---------------------------------------------------------------------------
# MAVLink Router
# ---------------------------------------------------------------------------
MAVLINK_UART_DEV=/dev/ttyACM0
MAVLINK_UART_BAUD=921600

# ---------------------------------------------------------------------------
# Servo Mapping
# ---------------------------------------------------------------------------
# Servo and relay outputs are controlled through the flight controller over
# MAVLink. The companion computer does not drive local GPIO/PWM outputs.
NOMAD_ENABLE_SERVOS=true

# ---------------------------------------------------------------------------
# MediaMTX (RTSP server)
# ---------------------------------------------------------------------------
RTSP_PORT=8554
MEDIAMTX_CONFIG=/home/USER/NOMAD/infra/mediamtx.yml
MEDIAMTX_BIN=/home/USER/bin/mediamtx

# ---------------------------------------------------------------------------
# Isaac ROS Container
# ---------------------------------------------------------------------------
ISAAC_CONTAINER_NAME=nomad_isaac_ros
ISAAC_IMAGE_NAME=nomad-isaac-ros:latest
ISAAC_IMAGE_FALLBACK=isaac_ros_dev-aarch64
ISAAC_WORKSPACE=/home/USER/workspaces/isaac_ros-dev
ISAAC_ROS_DOMAIN_ID=0

# ZED SDK pinned versions (provisioning installs these; runtime checks them)
ZED_WRAPPER_BRANCH=v5.2.0
ZED_SDK_VERSION=5.2.3
ZED_SDK_L4T_TARGET=l4t36.4

# ---------------------------------------------------------------------------
# ZED Wrapper (runtime)
# ---------------------------------------------------------------------------
ZED_CAMERA_MODEL=zed2i
ZED_CAMERA_NAME=zed
# NATIVE publishes the HD720 grab frame to ROS so onboard detection can run at
# 1280x720. The RTSP bridge still downscales separately for Mission Planner
# bandwidth. ZED_PUB_DOWNSCALE_FACTOR only applies when ZED_PUB_RESOLUTION is
# CUSTOM/OPTIMIZED.
ZED_PUB_RESOLUTION=NATIVE
# 720p — fits 8GB Orin Nano alongside nvblox. Switch to HD1080 only if ZED
# is the only GPU consumer.
ZED_GRAB_RESOLUTION=HD720
ZED_PUB_DOWNSCALE_FACTOR=2.0
ZED_PUBLISH_RAW=true
ZED_PUBLISH_LEFT_RIGHT=true
ZED_PUBLISH_MAG=true
# Higher values = more permissive (accept lower-confidence pixels) =
# more depth coverage at the cost of some noise. Default ZED SDK is 100
# (no filtering). 95/90 keeps almost everything but still rejects the
# most ambiguous returns -- needed so detector candidates always have
# a depth value for the physical-diameter gate.
ZED_DEPTH_CONFIDENCE=95
ZED_DEPTH_TEXTURE_CONF=90
# ZED depth backend: 'NEURAL_LIGHT' (fastest), 'NEURAL' (better in low-light/
# low-texture, ~10% heavier on GPU), 'NEURAL_PLUS' (best, heaviest), 'NONE'
# (disables depth — also breaks pos. tracking, mapping, etc.).
ZED_DEPTH_MODE=NEURAL_LIGHT
ZED_READY_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# ROS-HTTP Bridge
# ---------------------------------------------------------------------------
ROS_HTTP_BRIDGE_RATE=5
ROS_HTTP_BRIDGE_VIO_TOPIC=/zed/zed_node/odom
ROS_HTTP_BRIDGE_MAG_TOPIC=/zed/zed_node/imu/mag
ROS_HTTP_BRIDGE_TRANSPORT=http
# Override ROS2 install root and Isaac ROS workspace paths (used by
# common.sh ros_setup_prelude and by in-container scripts). Defaults are
# /opt/ros/humble and /workspaces/isaac_ros-dev.
NOMAD_ROS_ROOT=/opt/ros/humble
NOMAD_ISAAC_WORKSPACE=/workspaces/isaac_ros-dev
# Maximum age of the last received VIO update before navigation refuses
# velocity/position commands and reports VIO as stale.
NOMAD_VIO_MAX_AGE_S=1.0

# ---------------------------------------------------------------------------
# Video Bridge
# ---------------------------------------------------------------------------
VIDEO_BRIDGE_STREAM_PATH=primary
VIDEO_BRIDGE_WIDTH=640
VIDEO_BRIDGE_HEIGHT=360
VIDEO_BRIDGE_FPS=15
VIDEO_BRIDGE_BITRATE=800
NOMAD_DETECTIONS_AUTO_START=false
# 0.1 = 10 Hz detector loop. Drop to 0.067 (15 Hz) only if the Hough +
# CC pipeline can keep up on full-res frames; otherwise the loop falls
# behind frames and the overlay stops tracking the target.
NOMAD_DETECTOR_INTERVAL_S=0.1
# Downsample frames to this width before detection. 0 disables downsample
# (process full-res). 960 is a balance: enough resolution that 25cm
# targets at 5-10m range still have r=8-12 px (above the min_r floor),
# while ~2x faster than full-res HD720. 640 was too aggressive --
# distant targets shrank below the Hough/CC minimum.
# Detection coordinates carry _src_w/_src_h so the overlay renderer
# scales them back to display resolution.
NOMAD_DETECTOR_MAX_WIDTH=960
# Lifecycle owner: nomad-video-bridge.service (no in-process auto-start).

# ---------------------------------------------------------------------------
# nvblox (opt-in)
# ---------------------------------------------------------------------------
NVBLOX_CONFIG=/home/USER/NOMAD/config/nvblox_performance.yaml
NVBLOX_LAUNCH=/home/USER/NOMAD/config/launch/nomad_zed_nvblox.launch.py
NOMAD_PROBE_NVBLOX=false
NOMAD_ENABLE_NVBLOX_MESH=false

# ---------------------------------------------------------------------------
# Spray / aim geometry
# ---------------------------------------------------------------------------
# Stereo parallax correction for spray aim. The nozzle is colocated with the
# ZED2i *right* camera, but detection runs on the left image (ZED reference,
# where depth_registered is aligned). The servo controller compensates by shifting
# err_x by (fx_pub * baseline) / Z. fx_pub depends on grab resolution and
# downscale factor; baseline is 0.12 m for ZED2i.
#   HD720 native (1280x720), fx ≈ 534 px → at downscale 2.0 (640x360), fx ≈ 267 px
#   STEREO_FX_BASELINE = fx_pub * baseline = 267 * 0.12 ≈ 32 px·m
# Recompute if ZED_GRAB_RESOLUTION or ZED_PUB_DOWNSCALE_FACTOR changes.
NOMAD_STEREO_FX_BASELINE_PX_M=32.0

# ---------------------------------------------------------------------------
# Google Drive Upload (optional)
# ---------------------------------------------------------------------------
# Drive folder IDs for image/result upload. Set via gdrive_auth.py or manually.
GDRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Misc / feature flags
# ---------------------------------------------------------------------------
NOMAD_DEBUG=false
NOMAD_WATCHDOG_TIMEOUT=5.0
PYTHONUNBUFFERED=1

# ---------------------------------------------------------------------------
# Health monitor
# ---------------------------------------------------------------------------
NOMAD_HEALTH_POLL_INTERVAL_S=2.0
NOMAD_HEALTH_BROADCAST_INTERVAL_S=2.0

# ---------------------------------------------------------------------------
# Default video topic (used when VideoStreamManager is first created)
# ---------------------------------------------------------------------------
NOMAD_DEFAULT_VIDEO_TOPIC=/zed/zed_node/rgb/color/rect/image
# Explicit RTSP URL override (defaults to rtsp://{NOMAD_DOCKER_HOST_IP}:8554/primary)
NOMAD_RTSP_URL=

# ---------------------------------------------------------------------------
# MAVLink
# ---------------------------------------------------------------------------
NOMAD_MAVLINK_ENDPOINT=127.0.0.1:14550
NOMAD_MAVLINK_DISCONNECT_TIMEOUT_S=3.0
# Dedicated mavlink-router endpoint for the ROS-HTTP bridge's direct
# cmd_vel -> ArduPilot GUIDED velocity stream (MavlinkVelocityController).
# Must match the [UdpEndpoint nav_bridge] port in mavlink_router/main.conf.
NOMAD_BRIDGE_MAVLINK_ENDPOINT=127.0.0.1:14552

# Optional NOMAD-side keep-in geofence on position targets, independent of the
# FC fence (SR-FEN-02 in docs/safety/requirements.md). Semicolon-separated
# lat,lon vertices in WGS84 degrees, >= 3 of them, e.g.
#   NOMAD_FENCE_POLYGON=45.501,-73.601;45.501,-73.599;45.499,-73.599;45.499,-73.601
# Blank disables the check (the FC fence remains the only enforcement). A
# malformed value FAILS CLOSED: every position target is rejected until fixed.
NOMAD_FENCE_POLYGON=
# Keep-in margin in metres: targets closer than this to the boundary are
# rejected before the aircraft reaches the hard fence line.
NOMAD_FENCE_MARGIN_M=2.0
