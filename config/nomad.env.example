# Runtime environment alternative to the managed runtime JSON (--config).
# Copy to ignored config/nomad.env; use literal absolute paths for protected files.
# Service deployments use infra/runtime/runtime.example.json instead.
NOMAD_MAVLINK_ENDPOINT=udpin:127.0.0.1:14601
NOMAD_RUNTIME_IPC_PORT=14611
# Nonempty actuation-enable gate; this does not authenticate a client.
NOMAD_API_KEY=
NOMAD_CLIENT_CREDENTIALS_FILE=
NOMAD_AUDIT_DIRECTORY=
NOMAD_ACTUATORS_FILE=
# CLI credentials belong to the client environment, never to a shared profile.
NOMAD_CLIENT_ID=nomad-cli
NOMAD_CLIENT_CREDENTIAL=
# Direct qualification driver only; keep inhibited outside isolated tests.
NOMAD_INTEGRATED_FLIGHT=1
# Blank disables the target polygon check, never ArduPilot's native fence.
NOMAD_FENCE_POLYGON=
NOMAD_FENCE_MARGIN_M=2.0
NOMAD_VELOCITY_MAX_XY=2.0
NOMAD_VELOCITY_MAX_Z=1.0
NOMAD_VELOCITY_MAX_YAW_RATE=1.0
