# =============================================================================
# NOMAD Configuration Profile: GROUND STATION MINIMAL (Runtime IPC and standalone ground router)
# =============================================================================
#
# Load with:  python scripts/profile.py load groundstation_minimal
# Verify:     python scripts/profile.py show
#
# Minimal profile: No Jetson and no accelerated perception workload. Runtime
# and Mission Planner telemetry are configured by local deployment wiring.
# Installed CLI/runtime IPC v1 does not expose mission, navigation, geofence,
# or payload request paths. VIO/video-dependent workloads are not enabled.
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity & separation of concerns
# ---------------------------------------------------------------------------
NOMAD_PROFILE=groundstation_minimal
NOMAD_PROFILE_DESCRIPTION="Ground station minimal: Runtime IPC and standalone router, no companion or GPU perception"
NOMAD_COMPUTE_PLACEMENT=groundstation
NOMAD_HAS_COMPANION=false
NOMAD_HAS_PERCEPTION=false

# ---------------------------------------------------------------------------
# Service autostart — minimal ground station side
# ---------------------------------------------------------------------------
# Aircraft-side mavlink-routerd is not the standalone ground router.
NOMAD_AUTOSTART_MAVLINK_ROUTER=false
NOMAD_AUTOSTART_MEDIAMTX=false
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=false
NOMAD_AUTOSTART_ROS_VEHICLE=false
NOMAD_AUTOSTART_VIDEO_BRIDGE=false

# ---------------------------------------------------------------------------
# MAVLink endpoints (ground station side)
# ---------------------------------------------------------------------------
NOMAD_MAVLINK_ENDPOINT=udpin:127.0.0.1:14601
NOMAD_VIDEO_RTSP_URL=

# ---------------------------------------------------------------------------
# Qualification inhibition and simulation settings
# ---------------------------------------------------------------------------
NOMAD_INTEGRATED_FLIGHT=1
NOMAD_SIM_MODE=false
