# =============================================================================
# NOMAD Configuration Profile: GROUND STATION (no Jetson on the drone)
# =============================================================================
#
# Load with:  nomad profile load groundstation
# Verify:     nomad profile show
#
# Ground-station-hosted configuration: the NOMAD core and Mission Planner run
# on the ground station computer (or a Jetson at the ground station). The
# drone carries only an LTE module with a small bridge (Raspberry Pi Zero or
# similar) running mavlink-router over Tailscale, and optionally an ELRS RX
# for the RC/telemetry link.
#
# Two MAVLink paths reach the ground station:
#   - LTE path:  drone RPi (mavlink-router) -> Tailscale -> GCS UDP endpoint
#   - ELRS path: GCS ELRS TX -> serial -> GCS link aggregation
# The ground station aggregates both links into one stream for the core and
# plugin (mavlink-router on Linux GCS, the plugin's GroundLinkRouter on
# Windows). The system must keep working for whichever link is available and
# fail closed while both are down (SR-LNK-*).
#
# No drone-side services run in this profile: everything below is a
# ground-station-side setting.
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity
# ---------------------------------------------------------------------------
NOMAD_PROFILE=groundstation
NOMAD_PROFILE_DESCRIPTION="Ground-station hosted core: LTE/Tailscale + ELRS links, no Jetson on the drone"

# ---------------------------------------------------------------------------
# Service autostart - ground-station side only
# ---------------------------------------------------------------------------
NOMAD_AUTOSTART_EDGE_CORE=false
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
NOMAD_AUTOSTART_MEDIAMTX=false
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=false
NOMAD_AUTOSTART_ZED_WRAPPER=false
NOMAD_AUTOSTART_ROS_HTTP_BRIDGE=false
NOMAD_AUTOSTART_VIDEO_BRIDGE=false
NOMAD_AUTOSTART_NVBLOX=false
NOMAD_AUTOSTART_HEALTH_MONITOR=true
NOMAD_AUTOSTART_TIME_SYNC=true

# ---------------------------------------------------------------------------
# MAVLink endpoints (ground station side)
# ---------------------------------------------------------------------------
# Aggregated stream consumed by the NOMAD core and Mission Planner. The Linux
# GCS uses mavlink-router; the Windows plugin uses its GroundLinkRouter.
NOMAD_CORE_SITL_PORT=14570
# LTE path: mavlink-router on the drone RPi talks to this UDP port over
# Tailscale (must match the drone-side mavlink-router config).
NOMAD_LTE_UDP_PORT=14550
# ELRS path: serial device of the GCS ELRS transmitter (empty = no ELRS).
NOMAD_ELRS_SERIAL=/dev/ttyUSB0
NOMAD_ELRS_BAUD=115200

# ---------------------------------------------------------------------------
# Auth (shared with the core CLI; SR-SEC-02/03)
# ---------------------------------------------------------------------------
# Generate a real key for production: python -c "import secrets; print(secrets.token_hex(32))"
NOMAD_API_KEY=nomad-dev-sitl-key
NOMAD_ALLOW_INSECURE_REMOTE=false

# ---------------------------------------------------------------------------
# Geofence (GCS-side keep-in, SR-FEN-02)
# ---------------------------------------------------------------------------
NOMAD_FENCE_POLYGON=
NOMAD_FENCE_MARGIN_M=2.0
