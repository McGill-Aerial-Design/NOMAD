# =============================================================================
# NOMAD Configuration Profile: ONBOARD COMPANION (Jetson/SBC on the vehicle)
# =============================================================================
#
# Load with:  python scripts/profile.py load onboard_companion
# Verify:     python scripts/profile.py show
#
# Onboard companion configuration: Jetson or equivalent companion computer is
# installed on the vehicle. It may run ROS 2, VIO, camera/video, and approved
# perception workloads. The C++ core owns vehicle commands, telemetry models,
# validation, and MAVLink behavior.
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity & separation of concerns
# ---------------------------------------------------------------------------
NOMAD_PROFILE=onboard_companion
NOMAD_PROFILE_DESCRIPTION="Onboard companion: Jetson/SBC on vehicle runs ROS 2, VIO, and video workloads"
NOMAD_COMPUTE_PLACEMENT=onboard
NOMAD_HAS_COMPANION=true
NOMAD_HAS_PERCEPTION=true

# ---------------------------------------------------------------------------
# Service autostart — companion side
# ---------------------------------------------------------------------------
NOMAD_AUTOSTART_MAVLINK_ROUTER=true
# Optional compute stays disabled until its image, camera and estimator are qualified.
NOMAD_AUTOSTART_MEDIAMTX=false
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=false
NOMAD_AUTOSTART_ROS_VEHICLE=false
NOMAD_AUTOSTART_VIDEO_BRIDGE=false

# ---------------------------------------------------------------------------
# MAVLink and Video endpoints
# ---------------------------------------------------------------------------
NOMAD_MAVLINK_ENDPOINT=udpin:0.0.0.0:14550
NOMAD_VIDEO_RTSP_URL=rtsp://127.0.0.1:8554/stream

# ---------------------------------------------------------------------------
# Qualification inhibition and simulation settings
# ---------------------------------------------------------------------------
NOMAD_INTEGRATED_FLIGHT=1
NOMAD_SIM_MODE=false
