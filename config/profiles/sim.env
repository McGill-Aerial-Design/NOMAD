# =============================================================================
# NOMAD Configuration Profile: FULL SIMULATION
# =============================================================================
#
# Load with:  nomad profile load sim
# Verify:     nomad profile show
#
# This profile runs the entire NOMAD stack on a dev workstation (x86_64)
# using Isaac Sim + ArduPilot SITL. No Jetson, ZED camera, or flight
# controller hardware needed. The simulated ZED publishes the same ROS2
# topics as the real camera, so Edge Core and Mission Planner work
# identically to the real drone.
#
# Prerequisites:
# - NVIDIA GPU + NVIDIA Container Toolkit
# - Isaac Sim image built:  pixi run sim-build
# - ArduPilot SITL image pulled (included in docker-compose.sim.yml)
#
# Quick start:
#   nomad profile load sim
#   docker compose -f docker/docker-compose.sim.yml --profile sitl up
#   # Or manually:
#   nomad start isaac_sim && nomad start isaac_sim_zed
#   ISAAC_SIM_MODE=true python -m edge_core.main --sim --host 0.0.0.0
# =============================================================================

# ---------------------------------------------------------------------------
# Profile identity
# ---------------------------------------------------------------------------
NOMAD_PROFILE=sim
NOMAD_PROFILE_DESCRIPTION="Full Isaac Sim + SITL simulation (no hardware needed)"

# ---------------------------------------------------------------------------
# Service Autostart — sim services only
# ---------------------------------------------------------------------------
NOMAD_AUTOSTART_EDGE_CORE=true
NOMAD_AUTOSTART_MAVLINK_ROUTER=false
NOMAD_AUTOSTART_MEDIAMTX=true
NOMAD_AUTOSTART_ISAAC_ROS_CONTAINER=false
NOMAD_AUTOSTART_ZED_WRAPPER=false
NOMAD_AUTOSTART_ROS_HTTP_BRIDGE=false
NOMAD_AUTOSTART_VIDEO_BRIDGE=false
NOMAD_AUTOSTART_NVBLOX=false
NOMAD_AUTOSTART_ISAAC_SIM=true
NOMAD_AUTOSTART_ISAAC_SIM_ZED=true

# ---------------------------------------------------------------------------
# Paths — local workstation (replace USER with your login)
# ---------------------------------------------------------------------------
NOMAD_REPO_ROOT=/home/USER/NOMAD
NOMAD_LOG_DIR=/home/USER/nomad_logs
NOMAD_RUN_DIR=/run/nomad
NOMAD_DATA_DIR=/home/USER/NOMAD/data
NOMAD_MISSION_LOG_DIR=/home/USER/NOMAD/data/mission_logs
NOMAD_VENV=/home/USER/NOMAD/venv

# ---------------------------------------------------------------------------
# Network — local only, no Tailscale needed
# ---------------------------------------------------------------------------
NOMAD_API_HOST=0.0.0.0
NOMAD_API_PORT=8000
NOMAD_API_URL=http://localhost:8000
NOMAD_DOCKER_HOST_IP=172.17.0.1
NOMAD_TAILSCALE_HOSTNAME=nomad-sim
GCS_IP=
GCS_EXTRA_IPS=
GCS_PORT_LTE=14560
GCS_PORT_LOCAL=14550

# ---------------------------------------------------------------------------
# Auth — relaxed for local development
# ---------------------------------------------------------------------------
NOMAD_API_KEY=
NOMAD_INTERNAL_TOKEN=
NOMAD_ALLOW_INSECURE_REMOTE=true
NOMAD_ENABLE_TERMINAL_EXEC=false
NOVNC_VNC_PASSWORD=

# ---------------------------------------------------------------------------
# Sim mode — THIS IS THE KEY SWITCH
# ---------------------------------------------------------------------------
ISAAC_SIM_MODE=true
NOMAD_SIM_MODE=true
NOMAD_ENABLE_VISION=true

# ---------------------------------------------------------------------------
# MAVLink — no real UART, SITL provides MAVLink over UDP/TCP
# ---------------------------------------------------------------------------
MAVLINK_UART_DEV=/dev/null
MAVLINK_UART_BAUD=921600
NOMAD_MAVLINK_ENDPOINT=127.0.0.1:14550
NOMAD_MAVLINK_DISCONNECT_TIMEOUT_S=3.0
NOMAD_BRIDGE_MAVLINK_ENDPOINT=127.0.0.1:14552

# ---------------------------------------------------------------------------
# Servo — no physical servos in sim
# ---------------------------------------------------------------------------
NOMAD_ENABLE_SERVOS=false

# ---------------------------------------------------------------------------
# MediaMTX — local RTSP server
# ---------------------------------------------------------------------------
RTSP_PORT=8554
MEDIAMTX_CONFIG=/home/USER/NOMAD/infra/mediamtx.yml
MEDIAMTX_BIN=/home/USER/bin/mediamtx

# ---------------------------------------------------------------------------
# Isaac Sim Container (replaces Isaac ROS Container)
# ---------------------------------------------------------------------------
ISAAC_SIM_CONTAINER_NAME=nomad_isaac_sim
ISAAC_SIM_IMAGE_NAME=nomad-isaac-sim:latest
ISAAC_SIM_HEADLESS=1
ISAAC_SIM_WORLD=
ISAAC_SIM_DRONE_START_X=0.0
ISAAC_SIM_DRONE_START_Y=0.0
ISAAC_SIM_DRONE_START_Z=1.0
ISAAC_SIM_DRONE_START_YAW=0.0

# When in sim mode, the "Isaac ROS container" references point to the
# sim container for backward compatibility with scripts that check these.
ISAAC_CONTAINER_NAME=nomad_isaac_sim
ISAAC_IMAGE_NAME=nomad-isaac-sim:latest
ISAAC_IMAGE_FALLBACK=nomad-isaac-sim:latest
ISAAC_WORKSPACE=/workspaces/nomad-sim
ISAAC_ROS_DOMAIN_ID=0

# ---------------------------------------------------------------------------
# ZED — simulated camera settings
# ---------------------------------------------------------------------------
ZED_CAMERA_MODEL=zed2i
ZED_CAMERA_NAME=zed
ZED_PUB_RESOLUTION=NATIVE
ZED_GRAB_RESOLUTION=HD720
ZED_PUB_DOWNSCALE_FACTOR=2.0
ZED_PUBLISH_RAW=true
ZED_PUBLISH_LEFT_RIGHT=true
ZED_PUBLISH_MAG=true
ZED_DEPTH_CONFIDENCE=95
ZED_DEPTH_TEXTURE_CONF=90
ZED_DEPTH_MODE=NEURAL_LIGHT
ZED_READY_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# ROS-HTTP Bridge
# ---------------------------------------------------------------------------
ROS_HTTP_BRIDGE_RATE=5
ROS_HTTP_BRIDGE_VIO_TOPIC=/zed/zed_node/odom
ROS_HTTP_BRIDGE_MAG_TOPIC=/zed/zed_node/imu/mag
ROS_HTTP_BRIDGE_TRANSPORT=http
NOMAD_ROS_ROOT=/opt/ros/humble
NOMAD_ISAAC_WORKSPACE=/workspaces/nomad-sim
NOMAD_VIO_MAX_AGE_S=1.0

# ---------------------------------------------------------------------------
# Video Bridge
# ---------------------------------------------------------------------------
VIDEO_BRIDGE_STREAM_PATH=primary
VIDEO_BRIDGE_WIDTH=640
VIDEO_BRIDGE_HEIGHT=360
VIDEO_BRIDGE_FPS=15
VIDEO_BRIDGE_BITRATE=800
NOMAD_DETECTIONS_AUTO_START=false
NOMAD_DETECTOR_INTERVAL_S=0.1
NOMAD_DETECTOR_MAX_WIDTH=960

# ---------------------------------------------------------------------------
# nvblox — disabled in sim (no real 3D data from synthetic camera)
# ---------------------------------------------------------------------------
NVBLOX_CONFIG=/home/USER/NOMAD/config/nvblox_performance.yaml
NVBLOX_LAUNCH=/home/USER/NOMAD/config/launch/nomad_zed_nvblox.launch.py
NOMAD_PROBE_NVBLOX=false
NOMAD_ENABLE_NVBLOX_MESH=false

# ---------------------------------------------------------------------------
# Spray — no physical hardware
# ---------------------------------------------------------------------------
NOMAD_STEREO_FX_BASELINE_PX_M=32.0

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NOMAD_DEBUG=false
NOMAD_WATCHDOG_TIMEOUT=5.0
PYTHONUNBUFFERED=1
NOMAD_HEALTH_POLL_INTERVAL_S=2.0
NOMAD_HEALTH_BROADCAST_INTERVAL_S=2.0

# ---------------------------------------------------------------------------
# IPC
# ---------------------------------------------------------------------------
NOMAD_IPC_HEARTBEAT_PORT=5555
NOMAD_IPC_DATA_PORT=5556
NOMAD_IPC_HIGH_RATE_PORT=5557

# ---------------------------------------------------------------------------
# Video topics
# ---------------------------------------------------------------------------
NOMAD_DEFAULT_VIDEO_TOPIC=/zed/zed_node/rgb/color/rect/image
NOMAD_RTSP_URL=

# ---------------------------------------------------------------------------
# ZED SDK versions (informational in sim)
# ---------------------------------------------------------------------------
ZED_WRAPPER_BRANCH=v4.2.1
ZED_SDK_VERSION=4.2
ZED_SDK_L4T_TARGET=x86_64
