+        return false;
+    }
+    if (copter.g2.afs.controlled_termination_configured() && copter.g2.afs.termination_requested()) {
+        check_failed(display_failure, "Termination request active");
+        return false;
+    }
+    if (copter.g2.afs.controlled_termination_configured()) {
+        for (uint8_t i = 0; i < copter.num_flight_modes; i++) {
+            if (copter.flight_modes[i] == (int8_t)Mode::Number::TERMINATE) {
+                check_failed(display_failure, "Termination must use dedicated RC option");
+                return false;
+            }
+        }
+        if (!position_valid || position < 0 || position >= copter.num_flight_modes ||
+            copter.g.flight_mode_chan <= 0 || copter.g.flight_mode_chan > NUM_RC_CHANNELS) {
+            check_failed(display_failure, "Termination requires native RC mode switch");
+            return false;
+        }
+        RC_Channel *termination_input = rc().get_termination_input();
+        if (termination_input == nullptr) {
+            check_failed(display_failure, "Termination requires one valid dedicated RC input");
+            return false;
+        }
+        if (termination_input->get_aux_switch_pos() != RC_Channel::AuxSwitchPos::LOW) {
+            check_failed(display_failure, "Termination RC input must be valid LOW");
+            return false;
+        }
+#if AP_FENCE_ENABLED
+        char fence_failure[100] {};
+        if (!copter.fence.enabled() || !copter.fence.pre_arm_check(fence_failure, sizeof(fence_failure))) {
+            check_failed(display_failure, "Termination requires valid enabled fence");
+            return false;
+        }
+#else
+        check_failed(display_failure, "Termination requires native fence support");
+        return false;
+#endif
+        if (!copter.g2.afs.controlled_termination_available()) {
+            check_failed(display_failure, "Controlled termination unavailable");
+            return false;
+        }
+        if (!rc().option_is_enabled(RC_Channels::Option::IGNORE_OVERRIDES) ||
+            rc().option_is_enabled(RC_Channels::Option::IGNORE_RECEIVER) ||
+            rc().option_is_enabled(RC_Channels::Option::IGNORE_FAILSAFE) ||
+            copter.g.failsafe_throttle == FS_THR_DISABLED) {
+            check_failed(display_failure, "Termination requires physical RC failsafe, no overrides");
+            return false;
+        }
+        if (rc().get_fs_timeout_ms() > 4500 || !rc().has_had_rc_receiver() ||
+            AP_HAL::millis() - copter.last_radio_update_ms > rc().get_fs_timeout_ms() ||
+            !rc().has_valid_input() || copter.g2.afs.receiver_failsafe_active()) {
