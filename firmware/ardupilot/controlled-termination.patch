diff --git a/ArduCopter/mode_terminate.cpp b/ArduCopter/mode_terminate.cpp
new file mode 100644
index 0000000..6a2e42c
--- /dev/null
+++ b/ArduCopter/mode_terminate.cpp
@@ -0,0 +1,69 @@
+#include "Copter.h"
+
+#if AP_COPTER_ADVANCED_FAILSAFE_ENABLED
+
+bool ModeTerminate::enabled() const
+{
+    return g2.afs.enabled() && g2.afs.controlled_termination_configured() &&
+        g2.afs.supports_controlled_termination();
+}
+
+bool ModeTerminate::init(bool ignore_checks)
+{
+    if (_latched) {
+        return true;
+    }
+    if (!motors->armed() || !enabled() || !g2.afs.controlled_termination_available()) {
+        return false;
+    }
+
+    _descent_rate_ms = g2.afs.controlled_descent_rate_ms();
+    _control_position = copter.position_ok();
+    if (_control_position) {
+        pos_control->NE_set_max_speed_accel_m(wp_nav->get_default_speed_NE_ms(), wp_nav->get_wp_acceleration_mss());
+        pos_control->NE_set_correction_speed_accel_m(wp_nav->get_default_speed_NE_ms(), wp_nav->get_wp_acceleration_mss());
+        pos_control->NE_init_controller();
+    }
+    pos_control->D_set_max_speed_accel_m(_descent_rate_ms, wp_nav->get_default_speed_up_ms(), wp_nav->get_accel_D_mss());
+    pos_control->D_set_correction_speed_accel_m(_descent_rate_ms, wp_nav->get_default_speed_up_ms(), wp_nav->get_accel_D_mss());
+    if (!pos_control->D_is_active()) {
+        pos_control->D_init_controller();
+    }
+    _latched = true;
+    g2.afs.mark_controlled_termination();
+    GCS_SEND_TEXT(MAV_SEVERITY_CRITICAL, "Controlled termination latched %.2f m/s", (double)_descent_rate_ms);
+    return true;
+}
+
+void ModeTerminate::run()
+{
+    // Keep the native contact detector, spool-down and landed disarm behavior.
+    if (copter.ap.land_complete && motors->get_spool_state() == AP_Motors::SpoolState::GROUND_IDLE) {
+        copter.arming.disarm(AP_Arming::Method::LANDED);
+    }
+    if (is_disarmed_or_landed()) {
+        make_safe_ground_handling();
+        return;
+    }
+
+    if ((!copter.ekf_alt_ok() || !ahrs.healthy()) && millis() - _last_fault_ms > 1000) {
+        _last_fault_ms = millis();
+        GCS_SEND_TEXT(MAV_SEVERITY_CRITICAL, "Termination estimate unavailable");
+    }
+    motors->set_desired_spool_state(AP_Motors::DesiredSpoolState::THROTTLE_UNLIMITED);
+    if (_control_position && copter.position_ok()) {
+        Vector2f velocity_ne;
+        Vector2f acceleration_ne;
+        pos_control->input_vel_accel_NE_m(velocity_ne, acceleration_ne);
+        pos_control->NE_update_controller();
+        attitude_control->input_thrust_vector_rate_heading_rads(pos_control->get_thrust_vector(), 0.0f);
+    } else {
+        _control_position = false;
+        attitude_control->input_euler_angle_roll_pitch_euler_rate_yaw_rad(0.0f, 0.0f, 0.0f);
+    }
+    // No pilot repositioning, precision-landing pause or ordinary LAND rate change.
+    pos_control->D_set_pos_target_from_climb_rate_ms(-_descent_rate_ms);
+    pos_control->D_update_controller();
+}
+
+#endif // AP_COPTER_ADVANCED_FAILSAFE_ENABLED
diff --git a/ArduPlane/mode_terminate.cpp b/ArduPlane/mode_terminate.cpp
new file mode 100644
index 0000000..2c0d43a
--- /dev/null
+++ b/ArduPlane/mode_terminate.cpp
@@ -0,0 +1,61 @@
+#include "Plane.h"
+
+#if HAL_QUADPLANE_ENABLED && AP_ADVANCEDFAILSAFE_ENABLED
+
+bool ModeTerminate::prepare()
+{
+    if (_latched) {
+        return true;
+    }
+    if (!plane.arming.is_armed() || !plane.afs.controlled_termination_configured() || !quadplane.available()) {
+        return false;
+    }
+    // Capture before mode changes; aerodynamic termination does not require vertical navigation.
+    const bool vertical = quadplane.termination_is_vertical();
+    if (!plane.afs.controlled_termination_available(vertical)) {
+        return false;
+    }
+    _vertical = vertical;
+    _descent_rate_ms = plane.afs.controlled_descent_rate_ms();
+    return true;
+}
+
+bool ModeTerminate::_enter()
+{
+    if (_latched) {
+        return true;
+    }
+    if (_vertical) {
+        if (!ModeQLand::_enter()) {
+            return false;
+        }
+        pos_control->D_set_max_speed_accel_m(_descent_rate_ms, quadplane.pilot_speed_z_max_up_ms, quadplane.pilot_accel_z_mss);
+        pos_control->D_set_correction_speed_accel_m(_descent_rate_ms, quadplane.pilot_speed_z_max_up_ms, quadplane.pilot_accel_z_mss);
+    }
+    _latched = true;
+    plane.afs.mark_controlled_termination();
+    GCS_SEND_TEXT(MAV_SEVERITY_CRITICAL, "Termination latched: %s", _vertical ? "vertical" : "fixed wing");
+    return true;
+}
+
+void ModeTerminate::update()
+{
+    if (_vertical) {
+        ModeQLand::update();
+    }
+}
+
+void ModeTerminate::run()
+{
+    if (!_vertical) {
+        // Native AFS owns aerodynamic outputs, including motor shutdown.
+        return;
+    }
+    if (!quadplane.termination_estimate_available() && AP_HAL::millis() - _last_fault_ms > 1000) {
+        _last_fault_ms = AP_HAL::millis();
+        GCS_SEND_TEXT(MAV_SEVERITY_CRITICAL, "Termination estimate unavailable");
+    }
+    ModeQLand::run();
+}
+
+#endif // HAL_QUADPLANE_ENABLED && AP_ADVANCEDFAILSAFE_ENABLED
