+RC_Channel *RC_Channels::get_termination_input()
+{
+    RC_Channel *input = nullptr;
+    for (uint8_t i = 0; i < NUM_RC_CHANNELS; i++) {
+        RC_Channel *candidate = channel(i);
+        if (candidate != nullptr && candidate->option == (int16_t)RC_Channel::AUX_FUNC::TERMINATE) {
+            if (input != nullptr) {
+                return nullptr;
+            }
+            input = candidate;
+        }
+    }
+    if (input == nullptr || input->ch() > get_valid_channel_count() ||
+        input == &get_roll_channel() || input == &get_pitch_channel() ||
+        input == &get_yaw_channel() || input == &get_throttle_channel() ||
+        input == flight_mode_channel()) {
+        return nullptr;
+    }
+    const int16_t pwm = input->get_radio_in();
+    if (pwm <= RC_Channel::RC_MIN_LIMIT_PWM || pwm >= RC_Channel::RC_MAX_LIMIT_PWM) {
+        return nullptr;
+    }
+    return input;
