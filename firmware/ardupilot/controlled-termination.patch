+
+bool AP_AdvancedFailsafe_Plane::supports_controlled_termination() const
+{
+    return HAL_QUADPLANE_ENABLED && AP_RCPROTOCOL_ENABLED;
+}
+
+bool AP_AdvancedFailsafe_Plane::controlled_termination_active() const
+{
+#if HAL_QUADPLANE_ENABLED
+    return plane.mode_terminate.active();
+#else
+    return false;
+#endif
+}
+
+bool AP_AdvancedFailsafe_Plane::terminating_vehicle_via_landing() const
+{
+#if HAL_QUADPLANE_ENABLED
+    if (controlled_termination_active()) {
+        return plane.mode_terminate.vertical();
+    }
+    if (controlled_termination_configured()) {
+        // Preserve lift while controlled entry is pending or unavailable.
+        return true;
+    }
+#endif
+    return AP_AdvancedFailsafe::terminating_vehicle_via_landing();
+}
+
+bool AP_AdvancedFailsafe_Plane::controlled_termination_available(bool require_vertical) const
+{
+#if HAL_QUADPLANE_ENABLED
+    return controlled_parameters_valid() && plane.quadplane.available() &&
+        (!require_vertical || plane.quadplane.termination_available());
+#else
+    return false;
+#endif
+}
+
+bool AP_AdvancedFailsafe_Plane::receiver_failsafe_active() const
+{
+#if AP_RCPROTOCOL_ENABLED
+    return plane.failsafe.rc_failsafe || plane.rc_failsafe_active() || AP::RC().failsafe_active() ||
+        (controlled_termination_configured() && rc().get_termination_input() == nullptr);
+#else
+    return true;
+#endif
+}
+
+void AP_AdvancedFailsafe_Plane::mark_controlled_termination()
+{
+    _terminate.set_and_notify(1);
+}
+
+bool AP_AdvancedFailsafe_Plane::gcs_terminate(bool should_terminate, const char *reason)
+{
+    if (controlled_termination_active()) {
+        return should_terminate;
+    }
+    if (!controlled_termination_configured()) {
+        return AP_AdvancedFailsafe::gcs_terminate(should_terminate, reason);
+    }
+    if (!should_terminate) {
+        _terminate.set_and_notify(0);
+        return true;
+    }
+#if HAL_QUADPLANE_ENABLED
+    return plane.set_mode(plane.mode_terminate, ModeReason::TERMINATE);
+#else
+    return false;
+#endif
+}
+
 #endif // AP_ADVANCEDFAILSAFE_ENABLED
