+bool AP_Arming_Copter::termination_pre_arm_checks(bool display_failure)
+{
+    int8_t position = -1;
+    const bool position_valid = rc().get_raw_flight_mode_switch_position(position);
+    if (position_valid && position >= 0 && position < copter.num_flight_modes &&
+        copter.flight_modes[position] == (int8_t)Mode::Number::TERMINATE) {
