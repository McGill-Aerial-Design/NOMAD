# syntax=docker/dockerfile:1
# ==============================================================
# NOMAD Tier-1 hardware-free ROS2 sim image (x86_64, no CUDA/GPU).
#
# Compiles the C++ core + the nomad_ros ROS 2 adapter into a colcon workspace
# and ships rclpy + pymavlink, so the REAL nomad_vehicle_node can be exercised
# against an in-process MAVLink responder without a Jetson, ZED camera, or GPU
# (tests/ros/test_nomad_ros_integration.py).
#
# Relationship to the other images:
#   - Complements Dockerfile.dev (bare Edge Core, no ROS2) by adding a
#     full ROS2 Humble runtime for adapter integration testing.
#   - Mirrors Dockerfile.jetson minus the GPU/ZED-SDK/nvblox/colcon layers:
#     same COPY layout, same PYTHONPATH convention, same entrypoint.
#   - Does NOT build on aarch64/Jetson — use Dockerfile.jetson for the device.
#
# Build (repo root as context):
#   docker build -f docker/Dockerfile.sim-ros -t nomad-sim-ros:latest .
#
# Run the C++ vehicle node (connects to a MAVLink UDP stream):
#   docker run --rm nomad-sim-ros:latest \
#       ros2 run nomad_ros nomad_vehicle_node --ros-args \
#       -p endpoint:=udpin:0.0.0.0:14570
#
# Run an integration test suite (volume-mount tests/ at run time):
#   docker run --rm -v $(pwd)/tests:/opt/nomad/tests nomad-sim-ros:latest \
#       python3 -m pytest tests/ros/ -v
# ==============================================================

FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="The NOMAD Authors"
LABEL description="NOMAD Tier-1 hardware-free ROS2 sim image for adapter integration testing"

# ==============================================================
# ROS2 message packages the bridge imports + GStreamer (video bridge)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-geometry-msgs \
    ros-humble-nav-msgs \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-visualization-msgs \
    ros-humble-tf2-ros \
    ros-humble-rmw-fastrtps-cpp \
    python3-pip \
    curl \
    python3-gi \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    # C++ core + nomad_ros adapter build (exactly one vehicle implementation).
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    ros-humble-rclcpp \
    ros-humble-std-srvs \
    ros-humble-ament-cmake \
    ros-humble-ament-cmake-gtest \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# Python deps. numpy<2 keeps compatibility with the prebuilt ROS message
# packages (mirrors Dockerfile.jetson). pytest runs the tests/ros/ suite inside
# the image. pydantic is the only third-party import in edge_core/__init__.py's
# import chain (services.models) — required for the edge_core video bridge to
# import (the Isaac ROS base provides it on the Jetson; the lean ROS base here
# does not, so install it explicitly).
# ==============================================================
RUN pip3 install --no-cache-dir \
    pymavlink \
    transforms3d \
    pytest \
    pydantic \
    'numpy<2'

# ==============================================================
# NOMAD source. Copied to a layer path on PYTHONPATH so the video bridge and
# the synthetic publisher are importable without a workspace mount — mirrors
# the self-contained COPY layout in Dockerfile.jetson.
# tests/ is deliberately excluded (it is in .dockerignore and volume-mounted
# at run time so the image stays small and the test suite is always fresh).
# ==============================================================
COPY pyproject.toml README.md /opt/nomad/
COPY edge_core/ /opt/nomad/edge_core/
COPY infra/ /opt/nomad/infra/
COPY tools/ /opt/nomad/tools/

# ==============================================================
# C++ core + nomad_ros adapter. The adapter links nomad_core from the
# repository root as a subproject, so the repo-root CMake/headers/sources, the
# pinned MAVLink submodule (dialect headers for the codec), and the generator
# script are copied into a colcon workspace and built in the image.
# tests/ is excluded by .dockerignore; BUILD_TESTING is off for this build.
# The build context must come from a checkout with submodules initialized:
#   git submodule update --init --recursive
# ==============================================================
COPY CMakeLists.txt /ws/src/nomad/CMakeLists.txt
COPY include/ /ws/src/nomad/include/
COPY src/ /ws/src/nomad/src/
COPY scripts/dev/generate_mavlink.py /ws/src/nomad/scripts/dev/generate_mavlink.py
COPY third_party/ardupilot-mavlink/ /ws/src/nomad/third_party/ardupilot-mavlink/
COPY ros2/nomad_ros/ /ws/src/nomad/ros2/nomad_ros/
SHELL ["/bin/bash", "-c"]
RUN . /opt/ros/humble/setup.bash && cd /ws/src/nomad/ros2/nomad_ros && \
    colcon build --packages-select nomad_ros --build-base /ws/build --install-base /ws/install \
    --event-handlers console_cohesion+ 2>&1 | tail -5
SHELL ["/bin/sh", "-c"]

ENV PYTHONPATH="/opt/nomad"

# ==============================================================
# Environment
# ==============================================================
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_LOCALHOST_ONLY=0 lets DDS discovery work across the compose network.
ENV ROS_LOCALHOST_ONLY=0

WORKDIR /opt/nomad

# ==============================================================
# Entrypoint — sources ROS2 Humble, then exec's the CMD.
# ==============================================================
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]

# Default: run the C++ vehicle adapter node (replaces the retired Python
# ROS-HTTP bridge). Connect it to a MAVLink UDP stream with the endpoint
# parameter; the compose stack feeds udpin:0.0.0.0:14552.
CMD ["ros2", "run", "nomad_ros", "nomad_vehicle_node", "--ros-args", "-p", "endpoint:=udpin:0.0.0.0:14552"]
