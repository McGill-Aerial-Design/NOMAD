# ==============================================================
# NOMAD Isaac Sim Container Dockerfile (x86_64)
#
# Provides a full simulation environment with:
# - NVIDIA Isaac Sim 4.5 (Omniverse-based robotics simulator)
# - ROS 2 Humble (for topic-level compatibility with the real Jetson)
# - ZED SDK 4.2 (x86_64, for ZED API compatibility layer)
# - ZED ROS2 Wrapper (publishes same topics as the real ZED camera)
# - NOMAD ROS-HTTP Bridge + simple_video_bridge (in-container)
#
# The container runs Isaac Sim headless (via Vulkan rendering) and
# publishes the same ROS2 topics that the real Jetson publishes:
#   /zed/zed_node/odom          (VIO odometry)
#   /zed/zed_node/imu/data      (IMU)
#   /zed/zed_node/imu/mag       (Magnetometer)
#   /zed/zed_node/rgb/color/rect/image  (Video)
#   /zed/zed_node/depth/depth_registered (Depth)
#   /zed/zed_node/obj_det/objects        (Object detections)
#
# Edge Core and the Mission Planner see identical data whether
# the source is Isaac Sim or a real ZED2i on a Jetson.
#
# Requirements:
# - NVIDIA GPU with Vulkan support (RTX 2000+ series recommended)
# - NVIDIA Container Toolkit (nvidia-container-toolkit)
# - Docker with --gpus all support
#
# Build:
#   docker build -f docker/Dockerfile.isaac_sim -t nomad-isaac-sim:latest .
#
# Run (standalone):
#   docker run --gpus all -p 8000:8000 -p 8554:8554 nomad-isaac-sim:latest
#
# Or via docker compose:
#   docker compose -f docker/docker-compose.sim.yml up
# ==============================================================

ARG ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:4.5.0
FROM ${ISAAC_SIM_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="NOMAD Team"
LABEL description="NOMAD Isaac Sim + ZED SDK + ROS2 Humble for hardware-free drone simulation (x86_64)"

USER root

# ==============================================================
# System Dependencies
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    libusb-1.0-0-dev \
    python3-numpy \
    software-properties-common \
    gnupg2 \
    locales \
    lsb-release \
    # GStreamer for video bridge
    python3-gi \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    && rm -rf /var/lib/apt/lists/*

# Ensure UTF-8 locale
RUN locale-gen en_US en_US.UTF-8 && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# ==============================================================
# ROS 2 Humble (installed from official apt repo)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg2 \
    lsb-release \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
       -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
       http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
       > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ros-humble-ros-base \
       ros-humble-robot-localization \
       ros-humble-point-cloud-transport \
       ros-humble-tf2-ros \
       ros-humble-tf2-tools \
       ros-humble-navigation2 \
       ros-humble-nav2-bringup \
       ros-humble-nav2-msgs \
       ros-humble-image-transport \
       ros-humble-image-transport-plugins \
       ros-humble-vision-msgs \
       ros-humble-sensor-msgs \
       ros-humble-geometry-msgs \
       ros-humble-nav-msgs \
       ros-humble-std-msgs \
       ros-humble-visualization-msgs \
       python3-colcon-common-extensions \
       python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# ZED SDK 4.2 for x86_64 Ubuntu 22.04
# ==============================================================
# NOTE: ZED SDK x86_64 does NOT include the actual camera driver (that
# requires a physical ZED). The SDK here provides the Python API and
# shared libraries needed by the ZED ROS2 wrapper's simulation mode
# (which feeds synthetic frames from Isaac Sim through the SDK API).
ENV ZED_SDK_URL="https://download.stereolabs.com/zedsdk/4.2/ubuntu22"
RUN curl -L -o /tmp/zed_sdk.run ${ZED_SDK_URL} && \
    chmod +x /tmp/zed_sdk.run && \
    /tmp/zed_sdk.run -- silent skip_od_module && \
    rm /tmp/zed_sdk.run && \
    ldconfig || true

ENV LD_LIBRARY_PATH="/usr/local/zed/lib:${LD_LIBRARY_PATH:-}"

# ==============================================================
# ZED ROS2 Wrapper + ZED Messages
# ==============================================================
# Build from source so we can control the version and patch for sim mode.
ENV ZED_WRAPPER_BRANCH=v4.2.1
RUN mkdir -p /opt/zed_ros_ws/src && \
    cd /opt/zed_ros_ws/src && \
    git clone --branch ${ZED_WRAPPER_BRANCH} --depth 1 \
       https://github.com/stereolabs/zed-ros2-wrapper.git && \
    git clone --branch ${ZED_WRAPPER_BRANCH} --depth 1 \
       https://github.com/stereolabs/zed-ros2-interfaces.git && \
    cd /opt/zed_ros_ws && \
    bash -c "source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install \
       --cmake-args -Wno-dev \
       --packages-select zed_interfaces zed_wrapper \
    2>&1 | tail -30"

# ==============================================================
# Isaac ROS nvblox Utils (for mesh message compatibility)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    rm -rf /var/lib/apt/lists/* && \
    git clone --branch release-3.2 --depth 1 \
       https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git /tmp/isaac_nvblox_src && \
    mkdir -p /opt/isaac_ros_installed && \
    bash -c "set -e; \
    source /opt/ros/humble/setup.bash; \
    cd /tmp; \
    mkdir -p colcon_ws/src; \
    cp -r /tmp/isaac_nvblox_src/isaac_ros_nvblox_utils colcon_ws/src/; \
    cd colcon_ws; \
    colcon build --packages-select isaac_ros_nvblox_utils \
       --install-base /opt/isaac_ros_installed \
       --symlink-install --cmake-args -Wno-dev 2>&1 | tail -20; \
    rm -rf /tmp/colcon_ws /tmp/isaac_nvblox_src"

ENV ROS_PACKAGE_PATH="/opt/isaac_ros_installed/share:${ROS_PACKAGE_PATH:-}"
ENV CMAKE_PREFIX_PATH="/opt/isaac_ros_installed:${CMAKE_PREFIX_PATH:-}"

# ==============================================================
# Python Dependencies
# ==============================================================
RUN pip3 install --no-cache-dir \
    transforms3d \
    pymavlink \
    'numpy<2' \
    msgpack

# ==============================================================
# NOMAD Bridge Code (mounted at runtime, but also pre-copied for
# standalone container usage)
# ==============================================================
COPY edge_core/ros_http_bridge/ /opt/nomad/ros_http_bridge/
COPY edge_core/services/ros/ /opt/nomad/ros/

# ==============================================================
# NOMAD Isaac Sim Launch Scripts
# ==============================================================
COPY docker/isaac_sim/ /opt/nomad/isaac_sim/

# ==============================================================
# Workspace
# ==============================================================
WORKDIR /workspaces/nomad-sim

# ==============================================================
# Environment
# ==============================================================
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV __NV_PRIME_RENDER_OFFLOAD=1
ENV __GLX_VENDOR_LIBRARY_NAME=nvidia

# NOMAD-specific env defaults (overridden at runtime via docker compose)
ENV NOMAD_SIM_MODE=true
ENV NOMAD_ENABLE_VISION=true
ENV ISAAC_SIM_HEADLESS=1

# ==============================================================
# Entrypoint
# ==============================================================
COPY infra/docker/ros_entrypoint_sim.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash", "-c", "python3 /opt/nomad/isaac_sim/isaac_sim_zed_bridge.py && tail -f /dev/null"]
