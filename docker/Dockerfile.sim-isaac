# syntax=docker/dockerfile:1
# ==============================================================
# NOMAD Isaac ROS simulation image — x86_64 + NVIDIA dGPU.
#
# High-fidelity x86 counterpart to Dockerfile.sim-ros (CPU tier). This image
# mirrors Dockerfile.jetson as closely as x86 allows: same Isaac ROS stack,
# same ZED SDK 5.2.3, same nvblox pre-build, same C++ ROS adapter node —
# running on a developer workstation with a discrete NVIDIA GPU instead of a
# Jetson Orin.
#
# Requirements:
#   - An NVIDIA GPU exposed to Docker (WSL2 + nvidia-container-toolkit on Linux
#     or WSL2 on Windows; run `nvidia-smi` inside the container to verify).
#   - The Isaac ROS x86_64 dev base image already present locally. Build it
#     first via isaac_ros_common/scripts/build_image_layers.sh on your host
#     (see https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common). This image
#     is NOT based on a generic upstream; it requires that pre-built base.
#
# This image does NOT require a physical ZED camera. Drive ZED via:
#   - SVO playback:  pass an SVO file to zed_wrapper at launch
#   - Synthetic pub: tools/sim/zed_sim_publisher.py (see CMD comment below)
#
# Hosted CI cannot build or run this image (no GPU). Use a local machine or a
# self-hosted runner with an NVIDIA GPU.
#
# Build (repo root as context):
#   docker build -f docker/Dockerfile.sim-isaac \
#       --build-arg BASE_IMAGE=isaac_ros_dev-x86_64 \
#       -t nomad-sim-isaac:latest .
#
# ZED SDK / L4T / numpy versions are kept in lockstep with Dockerfile.jetson
# (JetPack 6.2 / L4T r36.4) so the sim mirrors the device as closely as
# possible. Update both files together when bumping SDK versions.
#
# Launch the C++ adapter node inside the running container (MAVLink fed by
# mavlink-router's nav_bridge leg on 127.0.0.1:14552):
#   ros2 run nomad_ros nomad_vehicle_node --ros-args -p endpoint:=udpin:0.0.0.0:14552
# Drive ZED (no physical camera):
#   python3 /opt/nomad/tools/sim/zed_sim_publisher.py
#   # OR mount an SVO: zed_wrapper --ros-args -p svo_file:=/data/recording.svo
# ==============================================================

ARG BASE_IMAGE=isaac_ros_dev-x86_64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="The NOMAD Authors"
LABEL description="NOMAD Isaac ROS + ZED + C++ ROS adapter node — x86_64 GPU simulation image"

# ==============================================================
# System dependencies (+ GStreamer for the video bridge)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    ca-certificates \
    libusb-1.0-0-dev \
    python3-numpy \
    python3-gi \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# ROS2 runtime packages (ZED wrapper + nvblox + nav2 need these after a restart)
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-zed-msgs \
    ros-humble-robot-localization \
    ros-humble-point-cloud-transport \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-nav2-msgs \
    # C++ core + nomad_ros adapter build (nomad_ros package.xml deps).
    ros-humble-rclcpp \
    ros-humble-std-srvs \
    ros-humble-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================
# ZED SDK 5.2.3 — x86_64 / Ubuntu 22.04 / CUDA 12 build.
# skip_drivers: no physical USB camera in the container.
# URL is overridable via --build-arg for testing against a newer patch release.
# Kept in lockstep with Dockerfile.jetson (5.2.3 / JetPack 6.2).
# ==============================================================
ARG ZED_SDK_URL="https://download.stereolabs.com/zedsdk/5.2.3/cu12/ubuntu22"
ENV ZED_SDK_URL=${ZED_SDK_URL}

RUN curl -L -o /tmp/zed_sdk.run ${ZED_SDK_URL} && \
    chmod +x /tmp/zed_sdk.run && \
    /tmp/zed_sdk.run -- silent skip_od_module skip_drivers && \
    rm /tmp/zed_sdk.run && \
    ldconfig

RUN test -f /usr/local/zed/lib/libsl_zed.so && \
    echo "ZED SDK installed successfully"

ENV LD_LIBRARY_PATH="/usr/local/zed/lib"

# ==============================================================
# Python deps for the ROS ecosystem. numpy is pinned <2 to stay compatible with
# the prebuilt ROS/nvblox/ZED packages on the base image.
# ==============================================================
RUN pip3 install --no-cache-dir \
    transforms3d \
    pymavlink \
    'numpy<2'

# ==============================================================
# Pre-build isaac_ros_nvblox_utils to a layer path (/opt) that survives a
# container restart, independent of any host workspace mount. Drop this stage if
# you do not use nvblox (the bridge runs fine with --disable-mesh).
# ==============================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    git clone --branch release-3.2 --depth 1 \
        https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git /tmp/isaac_nvblox_src && \
    rm -rf /var/lib/apt/lists/*

RUN bash -c "\
    set -e; \
    mkdir -p /opt/isaac_ros_installed; \
    source /opt/ros/humble/setup.bash 2>/dev/null || source /opt/ros/humble/install/setup.bash 2>/dev/null; \
    cd /tmp; \
    mkdir -p colcon_ws/src; \
    cp -r /tmp/isaac_nvblox_src/isaac_ros_nvblox_utils colcon_ws/src/; \
    cd colcon_ws; \
    colcon build --packages-select isaac_ros_nvblox_utils \
        --install-base /opt/isaac_ros_installed \
        --symlink-install --cmake-args -Wno-dev 2>&1 | tail -20; \
    rm -rf /tmp/colcon_ws /tmp/isaac_nvblox_src; \
"

ENV ROS_PACKAGE_PATH="/opt/isaac_ros_installed/share"
ENV CMAKE_PREFIX_PATH="/opt/isaac_ros_installed"

# ==============================================================
# NOMAD C++ core + nomad_ros adapter + synthetic publisher tools. The adapter
# links nomad_core from the repository root as a subproject, so the repo-root
# CMake/headers/sources, the pinned MAVLink submodule (dialect headers for the
# codec), and the generator script are copied into a colcon workspace and
# built in the image. /ws/install is sourced by docker/ros_entrypoint.sh at
# runtime. tools/ is included so zed_sim_publisher.py and other sim helpers
# are available without a host mount.
# The build context must come from a checkout with submodules initialized:
#   git submodule update --init --recursive
# ==============================================================
COPY CMakeLists.txt /ws/src/nomad/CMakeLists.txt
COPY include/ /ws/src/nomad/include/
COPY src/ /ws/src/nomad/src/
COPY scripts/dev/generate_mavlink.py /ws/src/nomad/scripts/dev/generate_mavlink.py
COPY third_party/ardupilot-mavlink/ /ws/src/nomad/third_party/ardupilot-mavlink/
COPY ros2/nomad_ros/ /ws/src/nomad/ros2/nomad_ros/
RUN bash -c "\
    set -e; \
    source /opt/ros/humble/setup.bash; \
    cd /ws/src/nomad/ros2/nomad_ros; \
    colcon build --packages-select nomad_ros \
        --build-base /ws/build --install-base /ws/install \
        --event-handlers console_cohesion+ 2>&1 | tail -5; \
"

# ==============================================================
# NOMAD Python source (video bridge + device-side stack) + sim tools.
# ==============================================================
COPY pyproject.toml README.md /opt/nomad/
COPY edge_core/ /opt/nomad/edge_core/
COPY infra/ /opt/nomad/infra/
COPY tools/ /opt/nomad/tools/
ENV PYTHONPATH="/opt/nomad"

# ==============================================================
# Environment
# ==============================================================
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:/usr/local/zed/lib:${LD_LIBRARY_PATH}"

WORKDIR /workspaces/isaac_ros-dev

# ==============================================================
# Entrypoint — sources ROS2 Humble + any built workspace, then exec's the CMD.
# ==============================================================
COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
