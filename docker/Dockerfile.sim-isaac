# syntax=docker/dockerfile:1
# ==============================================================
# NOMAD Isaac ROS adapter image — x86_64 + NVIDIA dGPU.
#
# This optional image provides the read-only ROS telemetry observer on an Isaac
# ROS base. It contains no camera SDK, mapping stack, obstacle-avoidance
# integration, or VIO-to-flight-control path.
# ==============================================================

ARG BASE_IMAGE=isaac_ros_dev-x86_64
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

LABEL maintainer="The NOMAD Authors"
LABEL description="NOMAD generic Isaac ROS adapter node — x86_64 GPU image"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rclcpp \
    ros-humble-ament-cmake \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    build-essential \
    cmake \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# The core's transport is MAVSDK, so its pinned submodule ships with the image;
# the MAVSDK subbuild fetches its own pinned dependencies at configure time.
COPY CMakeLists.txt /ws/src/nomad/CMakeLists.txt
COPY include/ /ws/src/nomad/include/
COPY src/ /ws/src/nomad/src/
COPY examples/ /ws/src/nomad/examples/
COPY third_party/MAVSDK/ /ws/src/nomad/third_party/MAVSDK/
COPY ros2/nomad_ros/ /ws/src/nomad/ros2/nomad_ros/

SHELL ["/bin/bash", "-c"]
# MAVSDK's nested mavlink submodule carries patches, and a checkout made on
# Windows can deliver them with CRLF line endings, which git apply rejects.
RUN sed -i 's/\r$//' /ws/src/nomad/third_party/MAVSDK/cpp/third_party/mavlink/mavlink.patch
RUN . /opt/ros/humble/setup.bash && cd /ws/src/nomad/ros2/nomad_ros && \
    colcon build --packages-select nomad_ros \
      --build-base /ws/build --install-base /ws/install \
      --event-handlers console_cohesion+
SHELL ["/bin/sh", "-c"]

ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOCALHOST_ONLY=0
ENV PYTHONPATH="/opt/nomad"

COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

WORKDIR /ws
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["ros2", "run", "nomad_ros", "nomad_vehicle_node", "--ros-args", "-p", "observation_endpoint:=udpin:0.0.0.0:14552"]
