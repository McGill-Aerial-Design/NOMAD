<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<model>
  <name>tiltrotor_tricopter</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>NOMAD contributors</name>
  </author>
  <description>
    Primitive-visual Gazebo fixture for the 1.8 kg ArduPlane vectored-yaw tilt-tricopter
    described by Tricopter_1p8kg_aircraft.json. Mass, inertia and published wing/tail
    areas come from that engineering model; motor/surface geometry and aerodynamic
    coefficients are approximate placeholders. The CAD STEP file is not embedded:
    dynamics use primitive collision and lift/drag surfaces, and no mesh is required
    to fly.
  </description>
</model>
