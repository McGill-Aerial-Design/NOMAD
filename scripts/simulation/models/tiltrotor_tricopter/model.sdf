<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  Primitive-visual 1.8 kg tilt-tricopter fixture. Body frame is x-forward, y-left,
  z-up; the model origin is the hover centre of gravity (the motor-hub centroid).
  Mass, inertia and published areas follow the supplied engineering JSON; motor
  and surface positions are approximate. Do not treat the coefficients or the
  primitive shapes as a measured digital twin.
-->
<sdf version="1.9">
  <model name="tiltrotor_tricopter">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <!-- Body CoM shifted aft so the three rotor hubs average to the model origin. -->
        <pose>-0.032 0 -0.002 0 0 0</pose>
        <mass>1.46</mass>
        <inertia>
          <ixx>0.07036144578313253</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.07915662650602409</iyy>
          <iyz>0</iyz>
          <izz>0.13192771084337349</izz>
        </inertia>
      </inertial>

      <visual name="fuselage">
        <pose>-0.05 0 0.01 0 0 0</pose>
        <geometry><box><size>0.55 0.12 0.10</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.31 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="fuselage_collision">
        <pose>-0.05 0 0.01 0 0 0</pose>
        <geometry><box><size>0.55 0.12 0.10</size></box></geometry>
      </collision>

      <visual name="wing">
        <pose>0.015 0 0.02 0 0 0</pose>
        <geometry><box><size>0.37 1.08 0.03</size></box></geometry>
        <material>
          <ambient>0.56 0.58 0.60 1</ambient>
          <diffuse>0.70 0.72 0.75 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="wing_collision">
        <pose>0.015 0 0.02 0 0 0</pose>
        <geometry><box><size>0.37 1.08 0.03</size></box></geometry>
      </collision>

      <visual name="tail_boom">
        <pose>-0.50 0 0.005 0 0 0</pose>
        <geometry><box><size>0.50 0.03 0.03</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.31 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="tail_boom_collision">
        <pose>-0.50 0 0.005 0 0 0</pose>
        <geometry><box><size>0.50 0.03 0.03</size></box></geometry>
      </collision>

      <visual name="fin">
        <pose>-0.64 0 0.08 0 0 0</pose>
        <geometry><box><size>0.0667 0.012 0.15</size></box></geometry>
        <material>
          <ambient>0.56 0.58 0.60 1</ambient>
          <diffuse>0.70 0.72 0.75 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="fin_collision">
        <pose>-0.64 0 0.08 0 0 0</pose>
        <geometry><box><size>0.0667 0.012 0.15</size></box></geometry>
      </collision>

      <visual name="front_boom_left">
        <pose>0.10 0.27 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.03 0.03</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.31 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="front_boom_left_collision">
        <pose>0.10 0.27 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.03 0.03</size></box></geometry>
      </collision>

      <visual name="front_boom_right">
        <pose>0.10 -0.27 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.03 0.03</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.31 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="front_boom_right_collision">
        <pose>0.10 -0.27 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.03 0.03</size></box></geometry>
      </collision>

      <visual name="rear_motor_mount">
        <pose>-0.50 0 0.03 0 0 0</pose>
        <geometry><box><size>0.12 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.20 0.22 0.25 1</ambient>
          <diffuse>0.28 0.31 0.35 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="rear_motor_mount_collision">
        <pose>-0.50 0 0.03 0 0 0</pose>
        <geometry><box><size>0.12 0.05 0.05</size></box></geometry>
      </collision>

      <visual name="gear_left">
        <pose>0.10 0.16 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="gear_left_collision">
        <pose>0.10 0.16 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
      </collision>

      <visual name="gear_right">
        <pose>0.10 -0.16 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="gear_right_collision">
        <pose>0.10 -0.16 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
      </collision>

      <visual name="gear_rear">
        <pose>-0.30 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="gear_rear_collision">
        <pose>-0.30 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.02 0.02 0.12</size></box></geometry>
      </collision>
    </link>

    <link name="imu_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-7</iyy>
          <iyz>0</iyz>
          <izz>1e-7</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <!-- ArduPilotPlugin forwards sensor vectors unchanged, so measure in FRD. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <link name="left_nacelle">
      <pose>0.25 0.27 0.02 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0006</iyy>
          <iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.16</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.16</size></box></geometry>
      </collision>
    </link>
    <link name="right_nacelle">
      <pose>0.25 -0.27 0.02 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0006</iyy>
          <iyz>0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.16</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.16</size></box></geometry>
      </collision>
    </link>

    <link name="left_propeller">
      <pose>0.25 0.27 0.07 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00007</iyy>
          <iyz>0</iyz>
          <izz>0.000136</izz>
        </inertia>
      </inertial>
      <visual name="disc">
        <geometry><cylinder><radius>0.16525</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 0.45</ambient>
          <diffuse>0.15 0.15 0.15 0.45</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="blade">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.33 0.02 0.004</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="right_propeller">
      <pose>0.25 -0.27 0.07 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00007</iyy>
          <iyz>0</iyz>
          <izz>0.000136</izz>
        </inertia>
      </inertial>
      <visual name="disc">
        <geometry><cylinder><radius>0.16525</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 0.45</ambient>
          <diffuse>0.15 0.15 0.15 0.45</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name="blade">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.33 0.02 0.004</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <link name="rear_propeller">
      <pose>-0.50 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00007</iyy>
          <iyz>0</iyz>
          <izz>0.000136</izz>
        </inertia>
      </inertial>
      <visual name="disc">
        <geometry><cylinder><radius>0.16525</radius><length>0.004</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.10 0.10 0.45</ambient>
          <diffuse>0.15 0.15 0.15 0.45</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
