    <link name="elevator">
      <pose>-0.655 0 0.005 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="surface">
        <pose>-0.04375 0 0 0 0 0</pose>
        <geometry><box><size>0.0875 0.40 0.012</size></box></geometry>
        <material>
          <ambient>0.56 0.58 0.60 1</ambient>
          <diffuse>0.70 0.72 0.75 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="surface_collision">
        <pose>-0.04375 0 0 0 0 0</pose>
        <geometry><box><size>0.0875 0.40 0.012</size></box></geometry>
      </collision>
    </link>

    <joint name="left_tilt_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_nacelle</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.261799</lower>
          <upper>1.570796</upper>
          <effort>1.5</effort>
          <velocity>4.363323</velocity>
        </limit>
        <dynamics><damping>0.05</damping><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <joint name="right_tilt_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_nacelle</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.261799</lower>
          <upper>1.570796</upper>
          <effort>1.5</effort>
          <velocity>4.363323</velocity>
        </limit>
        <dynamics><damping>0.05</damping><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>
    <joint name="left_prop_joint" type="revolute">
      <parent>left_nacelle</parent>
      <child>left_propeller</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1.0</effort>
          <velocity>800</velocity>
        </limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>
    <joint name="right_prop_joint" type="revolute">
      <parent>right_nacelle</parent>
      <child>right_propeller</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1.0</effort>
          <velocity>800</velocity>
        </limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>
    <joint name="rear_prop_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_propeller</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1.0</effort>
          <velocity>800</velocity>
        </limit>
        <dynamics><damping>0.0001</damping></dynamics>
      </axis>
    </joint>
    <joint name="left_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_aileron</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.436332</lower>
          <upper>0.436332</upper>
          <effort>1.5</effort>
          <velocity>6</velocity>
        </limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="right_aileron_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_aileron</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.436332</lower>
          <upper>0.436332</upper>
          <effort>1.5</effort>
          <velocity>6</velocity>
        </limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>
    <joint name="elevator_joint" type="revolute">
      <parent>base_link</parent>
      <child>elevator</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
          <effort>1.5</effort>
          <velocity>6</velocity>
        </limit>
        <dynamics><damping>0.01</damping></dynamics>
      </axis>
    </joint>

    <!-- Main wing: 0.2 m^2 total, less the two 0.012 m^2 ailerons. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>base_link</link_name>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>0.015 0 0.02</cp>
      <area>0.176</area>
      <air_density>1.225</air_density>
      <a0>0.04</a0>
      <cla>4.5</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-3.5</cla_stall>
      <cda_stall>-0.9</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>left_aileron</link_name>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>0 0 0</cp>
      <area>0.012</area>
      <air_density>1.225</air_density>
      <a0>0.04</a0>
      <cla>4.5</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-3.5</cla_stall>
      <cda_stall>-0.9</cda_stall>
      <cma_stall>0</cma_stall>
      <control_joint_name>left_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.5</control_joint_rad_to_cl>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>right_aileron</link_name>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>0 0 0</cp>
      <area>0.012</area>
      <air_density>1.225</air_density>
      <a0>0.04</a0>
      <cla>4.5</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-3.5</cla_stall>
      <cda_stall>-0.9</cda_stall>
      <cma_stall>0</cma_stall>
      <control_joint_name>right_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>1.5</control_joint_rad_to_cl>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>elevator</link_name>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>0 0 0</cp>
      <area>0.035</area>
      <air_density>1.225</air_density>
      <a0>0</a0>
      <cla>4.0</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.35</alpha_stall>
      <cla_stall>-3.0</cla_stall>
      <cda_stall>-0.9</cda_stall>
      <cma_stall>0</cma_stall>
      <control_joint_name>elevator_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.5</control_joint_rad_to_cl>
    </plugin>
    <!-- Vertical fin: side force, no modelled rudder. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>base_link</link_name>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>-0.64 0 0.05</cp>
      <area>0.01</area>
      <air_density>1.225</air_density>
      <a0>0</a0>
      <cla>4.0</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-3.0</cla_stall>
      <cda_stall>-0.9</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>

    <!-- Two blade elements per rotor. LiftDrag sees the blade centre-of-pressure
         velocity from the spinning joint, so static thrust scales with rotor speed
         and tilts with the nacelle. Blade area is calibrated to the supplied
         example 20 N static thrust per rotor at 800 rad/s. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>left_propeller</link_name>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <cp>0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>left_propeller</link_name>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <cp>-0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>right_propeller</link_name>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <cp>0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>right_propeller</link_name>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <cp>-0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>rear_propeller</link_name>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <cp>0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>rear_propeller</link_name>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <cp>-0.115 0 0</cp>
      <area>0.0018</area>
      <air_density>1.225</air_density>
      <a0>0.25</a0>
      <cla>4.2</cla>
      <cda>0.1</cda>
      <cma>0</cma>
      <alpha_stall>0.28</alpha_stall>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
    </plugin>

    <!-- ArduPilot writes joint forces directly; its PIDs need this position/velocity feedback. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>30</update_rate>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <!-- Model frame FLU -> ArduPilot body FRD; Gazebo ENU world -> NED. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_link::imu_sensor</imuName>

      <!-- SERVO1: front right motor, +800 rad/s at full output. -->
      <control channel="0">
        <jointName>right_prop_joint</jointName>
        <useForce>1</useForce>
        <multiplier>800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.0</cmd_max>
        <cmd_min>-1.0</cmd_min>
      </control>

      <!-- SERVO3: front left motor, opposite rotation. -->
      <control channel="2">
        <jointName>left_prop_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.0</cmd_max>
        <cmd_min>-1.0</cmd_min>
      </control>

      <!-- SERVO4: rear motor. -->
      <control channel="3">
        <jointName>rear_prop_joint</jointName>
        <useForce>1</useForce>
        <multiplier>800</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.05</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.0</cmd_max>
        <cmd_min>-1.0</cmd_min>
      </control>

      <!-- SERVO6: front left tilt, -15 deg (fully back) .. +90 deg (forward). -->
      <control channel="5">
        <jointName>left_tilt_joint</jointName>
        <useForce>1</useForce>
        <multiplier>1.832596</multiplier>
        <offset>-0.142857</offset>
        <servo_min>920</servo_min>
        <servo_max>2060</servo_max>
        <type>POSITION</type>
        <p_gain>15.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.3</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.5</cmd_max>
        <cmd_min>-1.5</cmd_min>
      </control>

      <!-- SERVO8: front right tilt, reversed horn: +90 deg .. -15 deg. -->
      <control channel="7">
        <jointName>right_tilt_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-1.832596</multiplier>
        <offset>-0.857143</offset>
        <servo_min>850</servo_min>
        <servo_max>2050</servo_max>
        <type>POSITION</type>
        <p_gain>15.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.3</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>1.5</cmd_max>
        <cmd_min>-1.5</cmd_min>
      </control>

      <!-- Positive roll output lowers the left trailing edge and raises the right.
           D=0.08 plus hinge damping is near critical for Iyy=1e-4 at the 1000 Hz flight step. -->
      <control channel="6">
        <jointName>left_aileron_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-0.698132</multiplier>
        <offset>-0.625</offset>
        <servo_min>1000</servo_min>
        <servo_max>1800</servo_max>
        <type>POSITION</type>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.08</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- SERVO9: right aileron, mirrored horn about the 1600 us trim. -->
      <control channel="8">
        <jointName>right_aileron_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-0.741760</multiplier>
        <offset>-0.588235</offset>
        <servo_min>1100</servo_min>
        <servo_max>1950</servo_max>
        <type>POSITION</type>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.08</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>

      <!-- SERVO10: elevator, 0.05 deg/us about the 1500 us trim. -->
      <control channel="9">
        <jointName>elevator_joint</jointName>
        <useForce>1</useForce>
        <multiplier>0.959931</multiplier>
        <offset>-0.545455</offset>
        <servo_min>900</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
        <p_gain>20.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0.08</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>
