<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>Exe</OutputType>
    <AssemblyName>NOMADMediaWorker</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DefineConstants>MEDIA_WORKER</DefineConstants>
    <MissionPlannerDir Condition="'$(MissionPlannerDir)' == ''">$(MSBuildProgramFiles32)\Mission Planner</MissionPlannerDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" />
    <Reference Include="netstandard" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(MissionPlannerDir)\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Memory"><HintPath>$(MissionPlannerDir)\System.Memory.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.ML.OnnxRuntime"><HintPath>..\..\build\vision\runtime\Microsoft.ML.OnnxRuntime.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="OpenCvSharp"><HintPath>..\..\build\vision\runtime\OpenCvSharp.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="*.cs" />
    <Compile Include="..\src\Vision\*.cs" Exclude="..\src\Vision\VisionModelCatalog.cs;..\src\Vision\GroundProjection.cs" />
    <Compile Include="..\src\Media\MediaWorkerProtocol.cs;..\src\Media\MediaPixels.cs;..\src\Media\VideoBufferMap.cs;..\src\Media\GStreamerVideoPipeline.cs" />
    <Compile Include="..\..\build\release\ReleaseIdentity.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\build\vision\runtime\Microsoft.ML.OnnxRuntime.dll;
      ..\..\build\vision\runtime\onnxruntime.dll;
      ..\..\build\vision\runtime\onnxruntime_providers_shared.dll;
      ..\..\build\vision\runtime\DirectML.dll;
      ..\..\build\vision\runtime\DirectML-LICENSE.txt;
      ..\..\build\vision\runtime\DirectML-NOTICES.txt;
      ..\..\build\vision\runtime\yolox_nano.onnx;
      ..\..\build\vision\runtime\vittrack.onnx;
      ..\..\build\vision\runtime\ViTTrack-LICENSE.txt;
      ..\..\build\vision\runtime\ONNX-RUNTIME-LICENSE.txt;
      ..\..\build\vision\runtime\ONNX-RUNTIME-NOTICES.txt;
      ..\..\build\vision\runtime\YOLOX-LICENSE.txt;
      ..\..\build\vision\runtime\OpenCvSharp.dll;
      ..\..\build\vision\runtime\OpenCvSharpExtern.dll;
      ..\..\build\vision\runtime\OpenCvSharp-NOTICES.txt;
      ..\..\build\vision\runtime\OPENCV-IPP-EULA.rtf;
      ..\..\build\vision\runtime\encoder.onnx;
      ..\..\build\vision\runtime\memory_attention.onnx;
      ..\..\build\vision\runtime\decoder.onnx;
      ..\..\build\vision\runtime\memory_encoder.onnx;
      ..\..\build\vision\runtime\constants.bin;
      ..\..\build\vision\runtime\EfficientTAM-LICENSE.txt">
      <LogicalName>NOMAD.Vision.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
