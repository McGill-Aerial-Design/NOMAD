<?xml version="1.0" encoding="utf-8"?>
<!--
  NOMAD Mission Planner Plugin Project
  Target: Mission Planner 1.3.x / .NET Framework 4.8

  Generate source identity with scripts/build/build_plugin_windows.ps1.
  Use the verified versioned packaging installer for deployment; see
  mission_planner/packaging/README.md. Direct IDE builds are development inputs.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AssemblyName>NOMADPlugin</AssemblyName>
    <RootNamespace>NOMAD.MissionPlanner</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <MissionPlannerDir Condition=" '$(MissionPlannerDir)' == '' ">$(MSBuildProgramFiles32)\Mission Planner</MissionPlannerDir>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework References -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Speech" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Memory">
      <HintPath>$(MissionPlannerDir)\System.Memory.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Mission Planner References -->
    <Reference Include="GMap.NET.Core">
      <HintPath>$(MissionPlannerDir)\GMap.NET.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GMap.NET.Drawing">
      <HintPath>$(MissionPlannerDir)\GMap.NET.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GMap.NET.WindowsForms">
      <HintPath>$(MissionPlannerDir)\GMap.NET.WindowsForms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.ArduPilot.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Comms">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Comms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Controls">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Utilities">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Interfaces">
      <HintPath>$(MissionPlannerDir)\Interfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MAVLink">
      <HintPath>$(MissionPlannerDir)\MAVLink.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Newtonsoft.Json -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MissionPlannerDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      All C# sources are globbed so new files - and the many partial-class splits
      this plugin uses - build without being hand-registered here. This is a plain
      MSBuild wildcard, so it still builds with Visual Studio's MSBuild and the
      .NET Framework targeting pack alone (no .NET SDK required, unlike an
      SDK-style project). obj/ and bin/ are excluded so generated
      AssemblyAttributes and prior build output are never compiled.
    -->
    <!-- Mission Planner links router config/status contracts and the elapsed clock. The standalone host owns routing. -->
    <Compile Include="..\..\infra\transport\ground_router\RouterClock.cs" />
    <Compile Include="..\..\infra\transport\ground_router\RouterConfig.cs" />
    <Compile Include="..\..\infra\transport\ground_router\RouterManagementProtocol.cs" />
        <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;Plugin\ReleaseIdentity.cs" />
    <Compile Include="..\..\build\release\ReleaseIdentity.cs" Condition="Exists('..\..\build\release\ReleaseIdentity.cs')" />
    <Compile Include="Plugin\ReleaseIdentity.cs" Condition="!Exists('..\..\build\release\ReleaseIdentity.cs')" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
