<?xml version="1.0" encoding="utf-8"?>
<!--
  NOMAD Mission Planner Plugin Project
  Target: Mission Planner 1.3.x / .NET Framework 4.8

  Build Instructions:
  1. Open in Visual Studio 2022
  2. Build > Build Solution (Ctrl+Shift+B)
  3. Copy bin\Release\NOMADPlugin.dll to Mission Planner plugins folder
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AssemblyName>NOMADPlugin</AssemblyName>
    <RootNamespace>NOMAD.MissionPlanner</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework References -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Speech" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Memory">
      <HintPath>C:\Program Files (x86)\Mission Planner\System.Memory.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- WPF References for Helix Toolkit 3D Visualization -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- OpenTK for cross-platform 3D SLAM visualization (ships with Mission Planner) -->
  <ItemGroup>
    <Reference Include="OpenTK">
      <HintPath>C:\Program Files (x86)\Mission Planner\OpenTK.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OpenTK.GLControl">
      <HintPath>C:\Program Files (x86)\Mission Planner\OpenTK.GLControl.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Mission Planner References -->
    <Reference Include="MissionPlanner">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.ArduPilot.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Comms">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.Comms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Controls">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Utilities">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Drawing">
      <HintPath>C:\Program Files (x86)\Mission Planner\MissionPlanner.Drawing.dll</HintPath>
      <Private>False</Private>
      <Aliases>MPDrawing</Aliases>
    </Reference>
    <Reference Include="Interfaces">
      <HintPath>C:\Program Files (x86)\Mission Planner\Interfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MAVLink">
      <HintPath>C:\Program Files (x86)\Mission Planner\MAVLink.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Newtonsoft.Json -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files (x86)\Mission Planner\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- SkiaSharp for video frame handling -->
    <Reference Include="SkiaSharp">
      <HintPath>C:\Program Files (x86)\Mission Planner\SkiaSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      All C# sources are globbed so new files - and the many partial-class splits
      this plugin uses - build without being hand-registered here. This is a plain
      MSBuild wildcard, so it still builds with Visual Studio's MSBuild and the
      .NET Framework targeting pack alone (no .NET SDK required, unlike an
      SDK-style project). obj/ and bin/ are excluded so generated
      AssemblyAttributes and prior build output are never compiled.
    -->
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <!-- Optional local references for LibVLCSharp managed assemblies (place DLLs in third_party/libvlc) -->
  <ItemGroup>
    <Reference Include="LibVLCSharp.WinForms" Condition="Exists('..\third_party\libvlc\LibVLCSharp.WinForms.dll')">
      <HintPath>..\third_party\libvlc\LibVLCSharp.WinForms.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="LibVLCSharp.Shared" Condition="Exists('..\third_party\libvlc\LibVLCSharp.Shared.dll')">
      <HintPath>..\third_party\libvlc\LibVLCSharp.Shared.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
