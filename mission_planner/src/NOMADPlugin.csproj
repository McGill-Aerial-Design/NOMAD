<?xml version="1.0" encoding="utf-8"?>
<!--
  NOMAD Mission Planner Plugin Project
  Target: Mission Planner 1.3.x / .NET Framework 4.8

  Generate source identity with scripts/build/build_plugin_windows.ps1.
  Use the reviewed manual installation procedure; see
  mission_planner/packaging/README.md. Direct IDE builds are development inputs.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AssemblyName>NOMADPlugin</AssemblyName>
    <RootNamespace>NOMAD.MissionPlanner</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <MissionPlannerDir Condition=" '$(MissionPlannerDir)' == '' ">$(MSBuildProgramFiles32)\Mission Planner</MissionPlannerDir>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework References -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Speech" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Memory">
      <HintPath>$(MissionPlannerDir)\System.Memory.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="netstandard" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mission Planner References -->
    <!-- WPF markup inspection also resolves the reviewed host's scripting signatures. -->
    <Reference Include="Xamarin.Forms.Core">
      <HintPath>$(MissionPlannerDir)\Xamarin.Forms.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Dynamic">
      <HintPath>$(MissionPlannerDir)\Microsoft.Dynamic.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Scripting">
      <HintPath>$(MissionPlannerDir)\Microsoft.Scripting.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GMap.NET.Core">
      <HintPath>$(MissionPlannerDir)\GMap.NET.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GMap.NET.Drawing">
      <HintPath>$(MissionPlannerDir)\GMap.NET.Drawing.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GMap.NET.WindowsForms">
      <HintPath>$(MissionPlannerDir)\GMap.NET.WindowsForms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.ArduPilot.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Comms">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Comms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Controls">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MissionPlanner.Utilities">
      <HintPath>$(MissionPlannerDir)\MissionPlanner.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Interfaces">
      <HintPath>$(MissionPlannerDir)\Interfaces.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MAVLink">
      <HintPath>$(MissionPlannerDir)\MAVLink.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Newtonsoft.Json -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MissionPlannerDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      All C# sources are globbed so new files - and the many partial-class splits
      this plugin uses - build without being hand-registered here. This is a plain
      MSBuild wildcard, so it still builds with Visual Studio's MSBuild and the
      .NET Framework targeting pack alone (no .NET SDK required, unlike an
      SDK-style project). obj/ and bin/ are excluded so generated
      AssemblyAttributes and prior build output are never compiled.
    -->
    <Compile Include="..\..\infra\transport\ground_router\*.cs" />
        <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;Plugin\ReleaseIdentity.cs;Vision\YoloXVideoDetector.cs;Vision\ObjectVisualTracker*.cs;Vision\AreaVisualTracker*.cs;Vision\EfficientTam*.cs;Vision\FrozenAppearance.cs;Vision\ObjectRecoveryReference.cs;Vision\ObjectForeground.cs;Vision\VisualTrackingImage.cs;Vision\VisualFeatureMatching.cs;Vision\CpuTemplateTracker.cs;Vision\GpuAdapter.cs" />
    <Compile Include="..\..\build\release\ReleaseIdentity.cs" Condition="Exists('..\..\build\release\ReleaseIdentity.cs')" />
    <Compile Include="Plugin\ReleaseIdentity.cs" Condition="!Exists('..\..\build\release\ReleaseIdentity.cs')" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="UI\WpfTheme.xaml;UI\VideoToolbarView.xaml;UI\VideoStatusView.xaml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\build\media_worker\bundle.json;..\..\build\media_worker\NOMADMediaWorker.exe;..\..\build\media_worker\NOMADMediaWorker.exe.config;..\..\build\media_worker\Newtonsoft.Json.dll;..\..\build\media_worker\System.Memory.dll;..\..\build\media_worker\System.Buffers.dll;..\..\build\media_worker\System.Numerics.Vectors.dll;..\..\build\media_worker\System.Runtime.CompilerServices.Unsafe.dll">
      <LogicalName>NOMAD.Media.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="CheckMediaInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\..\build\media_worker\bundle.json')"
      Text="Build the media worker using scripts/build/build_plugin_windows.ps1." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
