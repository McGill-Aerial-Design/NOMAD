{
  "version": "2.0.0",
  "tasks": [
    // ==================== Configuration Profiles ====================
    // These tasks appear in the VS Code status bar via "Run Task".
    // Switch between real drone and supported ground-station profiles.
    {
      "label": "Profile: Load onboard companion",
      "type": "shell",
      "command": "pixi run profile-load onboard_companion",
      "group": "none",
      "presentation": {
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Onboard companion placement; optional compute services remain disabled until qualified."
    },
    {
      "label": "Profile: Show active",
      "type": "shell",
      "command": "pixi run profile-show",
      "group": "none",
      "presentation": {
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Display the active profile name, sim mode, vision, and config path."
    },
    {
      "label": "Profile: List all",
      "type": "shell",
      "command": "pixi run profile-list",
      "group": "none",
      "presentation": {
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "List all available configuration profiles."
    },
    {
      "label": "Profile: Edit current config",
      "type": "shell",
      "command": "pixi run profile-edit",
      "group": "none",
      "presentation": {
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Open config/nomad.env in your editor ($EDITOR or Notepad)."
    },
    {
      "label": "Profile: Save current as new profile",
      "type": "shell",
      "command": "pixi run profile-save ${input:profileName}",
      "group": "none",
      "presentation": {
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "detail": "Snapshot the current config/nomad.env into config/profiles/<name>.env"
    },
    // ==================== Python tools ====================
    {
      "label": "Python: Run tests",
      "type": "shell",
      "command": "pixi run test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run pytest"
    },
    {
      "label": "Python: Lint (ruff check)",
      "type": "shell",
      "command": "pixi run lint",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run ruff check on the entire codebase"
    },
    {
      "label": "Python: Format (ruff format)",
      "type": "shell",
      "command": "pixi run fmt",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Auto-format all Python files with ruff"
    },
    {
      "label": "Python: Type check (mypy)",
      "type": "shell",
      "command": "pixi run typecheck",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run mypy type checker (gradual, advisory)"
    },
    // ==================== Simulation Stacks ====================
    {
      "label": "Sim ROS: Build image",
      "type": "shell",
      "command": "pixi run sim-ros-build",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Build the CPU ROS2 simulation image"
    },
    {
      "label": "Sim ROS: Start stack",
      "type": "shell",
      "command": "pixi run sim-ros-up",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true, "showReuseMessage": false },
      "problemMatcher": [],
      "detail": "Start the C++ ROS adapter and SITL stack"
    },
    {
      "label": "Sim ROS: Stop stack",
      "type": "shell",
      "command": "pixi run sim-ros-down",
      "group": "none",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Stop and remove the ROS simulation stack"
    },
    {
      "label": "Sim ROS: Logs",
      "type": "shell",
      "command": "pixi run sim-ros-logs",
      "group": "none",
      "presentation": { "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": [],
      "detail": "Follow logs from the ROS simulation stack"
    },
    {
      "label": "Sim ROS: Integration test",
      "type": "shell",
      "command": "pixi run test-ros-integration",
      "group": "test",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run ROS bridge integration tests inside the sim-ros image"
    },
    // ==================== C# ====================
    {
      "label": "C#: Build Mission Planner Plugin",
      "type": "shell",
      "command": "pixi run build-plugin-only",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Build NOMADPlugin.dll without installing it (requires Visual Studio + Mission Planner)"
    },
    {
      "label": "C#: Lint plugin for dead code",
      "type": "shell",
      "command": "pixi run lint-plugin",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Rebuild treating unused fields/locals/unreachable code as errors"
    },
    // ==================== Docker (dev) ====================
    // These call the pixi `dev-*` tasks (see pixi.toml) so the compose flags are
    // defined in one place.
    {
      "label": "Core: Build",
      "type": "shell",
      "command": "pixi run dev-build",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Build the C++ core"
    },
    {
      "label": "Docker: Build + start dev stack (SITL)",
      "type": "shell",
      "command": "pixi run dev-up",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true, "showReuseMessage": false },
      "problemMatcher": [],
      "detail": "Build and start the ArduPilot SITL stack (detached)"
    },
    {
      "label": "Docker: Stop dev stack",
      "type": "shell",
      "command": "pixi run dev-down",
      "group": "none",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Stop and remove the dev stack"
    },
    {
      "label": "Docker: Dev stack logs",
      "type": "shell",
      "command": "pixi run dev-logs",
      "group": "none",
      "presentation": { "panel": "dedicated", "showReuseMessage": false },
      "problemMatcher": [],
      "detail": "Follow logs from the dev stack"
    },
    // ==================== Documentation ====================
    {
      "label": "Docs: Build site",
      "type": "shell",
      "command": "pixi run docs-build",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Build ProperDocs site with strict mode"
    },
    {
      "label": "Docs: Serve locally",
      "type": "shell",
      "command": "pixi run docs",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Serve ProperDocs site on http://localhost:8001 (auto-reload)"
    },
    // ==================== Development Environment ====================
    {
      "label": "Bootstrap: Set up dev environment",
      "type": "shell",
      "command": "pixi run bootstrap",
      "group": "none",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run the bootstrap script (install pixi env, pre-commit hooks, smoke test)"
    },
    {
      "label": "Bootstrap: Install pre-commit hooks",
      "type": "shell",
      "command": "pixi run precommit",
      "group": "none",
      "presentation": { "panel": "dedicated", "clear": true },
      "problemMatcher": [],
      "detail": "Run pre-commit hooks on all files"
    }
  ],
  "inputs": [
    {
      "id": "profileName",
      "type": "promptString",
      "description": "Profile name to save as",
      "default": "my_profile"
    }
  ]
}
